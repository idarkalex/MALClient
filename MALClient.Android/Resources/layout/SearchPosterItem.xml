<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/GridCardHeight"
    android:foreground="?android:selectableItemBackground">

  <FFImageLoading.Views.ImageViewAsync
      android:id="@+id/SearchPosterImage"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="centerCrop"
      android:background="?BrushAppBars"
      tools:src="@drawable/annak" />

  <TextView
      android:id="@+id/SearchPosterScore"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="top|end"
      android:layout_margin="6dp"
      android:background="@drawable/electric_midnight_grid_badge"
      android:fontFamily="@font/inter"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:textColor="#ffffff"
      android:textSize="10sp"
      android:textStyle="bold"
      android:visibility="gone"
      tools:text="8.50" />

  <TextView
      android:id="@+id/SearchPosterTitle"
      style="@style/GridCardTitleStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:textColor="#ffffff" />

</FrameLayout>
