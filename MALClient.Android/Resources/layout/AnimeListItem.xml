<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:selectableItemBackground"
    android:longClickable="true">

  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="16dp"
      android:layout_marginEnd="16dp"
      android:layout_marginTop="8dp"
      android:layout_marginBottom="8dp"
      android:background="@drawable/electric_midnight_glass_panel"
      android:clipToPadding="false"
      android:orientation="horizontal"
      android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <FrameLayout
          android:layout_width="90dp"
          android:layout_height="130dp"
          android:layout_marginEnd="12dp">

        <ProgressBar
            android:id="@+id/AnimeListItemImgPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:alpha=".3"
            android:indeterminate="true"
            android:indeterminateTint="?BrushSettingsSubtitle"
            android:indeterminateTintMode="src_in"
            android:scaleX=".7"
            android:scaleY=".7" />

        <FFImageLoading.Views.ImageViewAsync
            android:id="@+id/AnimeListItemImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />
      </FrameLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/AnimeListItemTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:fontFamily="@font/inter"
            android:textColor="?BrushText"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Shelter" />

        <TextView
            android:id="@+id/AnimeListItemAltTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:fontFamily="@font/inter"
            android:textColor="?BrushTextSecondary"
            android:textSize="13sp"
            tools:text="" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

          <TextView
              android:id="@+id/AnimeListItemScoreText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginEnd="4dp"
              android:fontFamily="@font/inter"
              android:text="8.74"
              android:textColor="?AccentColour"
              android:textSize="@dimen/EmLabelSm"
              android:textStyle="bold" />

          <View
              android:layout_width="1dp"
              android:layout_height="14dp"
              android:layout_marginEnd="6dp"
              android:background="?BrushTextSecondary" />

          <TextView
              android:id="@+id/AnimeListItemTypeTextView"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="TV"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps"
              tools:text="Tv" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

          <TextView
              android:id="@+id/AnimeListItemEpisodeCountText"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:ellipsize="end"
              android:fontFamily="@font/inter"
              android:maxLines="1"
              android:text="24/24 episodes"
              android:textColor="?BrushText"
              android:textSize="13sp" />

          <Button
              android:id="@+id/AnimeListItemStatusButton"
              android:layout_width="wrap_content"
              android:layout_height="25dp"
              android:background="@drawable/electric_midnight_badge"
              android:fontFamily="@font/inter"
              android:minWidth="56dp"
              android:paddingStart="8dp"
              android:paddingEnd="8dp"
              android:text="Watching"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?AccentColour"
              android:textSize="@dimen/EmLabelCaps"
              android:textStyle="bold"
              tools:text="Watching" />

          <TextView
              android:id="@+id/AnimeListItemScoreValueText"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:background="@drawable/electric_midnight_badge"
              android:fontFamily="@font/inter"
              android:gravity="center"
              android:minHeight="25dp"
              android:minWidth="56dp"
              android:paddingStart="8dp"
              android:paddingEnd="8dp"
              android:text="8/10"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?AccentColour"
              android:textSize="@dimen/EmLabelCaps"
              android:textStyle="bold"
              tools:text="8/10" />
        </LinearLayout>
      </LinearLayout>

      <!-- Add to list button -->
      <FrameLayout
          android:id="@+id/AnimeListItemAddToListButton"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:layout_gravity="top|end"
          android:layout_marginStart="8dp"
          android:layout_marginTop="-8dp"
          android:background="@drawable/electric_midnight_glass_button"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?android:selectableItemBackground"
          android:padding="4dp"
          android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_add"
            android:tint="?BrushText" />
      </FrameLayout>

      <!-- Tags button -->
      <FrameLayout
          android:id="@+id/AnimeListItemTagsButton"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/electric_midnight_glass_button"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?android:selectableItemBackground"
          android:padding="4dp"
          android:visibility="gone">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/icon_tag"
            android:tint="?BrushText" />
      </FrameLayout>

      <!-- Priority indicator -->
      <View
          android:id="@+id/PriorityIndicator"
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:layout_gravity="top|start"
          android:layout_margin="4dp"
          android:background="@color/OnHoldColour"
          android:rotation="-45"
          android:visibility="gone" />

      <!-- Inc Dec buttons -->
      <LinearLayout
          android:id="@+id/AnimeListItemIncDecSection"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom|end"
          android:layout_margin="8dp"
          android:orientation="vertical">

        <ImageButton
            android:id="@+id/AnimeListItemIncButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/electric_midnight_glass_button"
            android:fontFamily="@font/inter"
            android:padding="4dp"
            android:src="@drawable/icon_add"
            android:tint="?BrushText" />

        <ImageButton
            android:id="@+id/AnimeListItemDecButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/electric_midnight_glass_button"
            android:fontFamily="@font/inter"
            android:src="@drawable/icon_minus"
            android:tint="?BrushText" />
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
