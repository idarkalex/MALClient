<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="48dp"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?selectableItemBackground"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingStart="16dp"
              android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/SettingsPageItemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/icon_settings"
        android:tint="?BrushTextSecondary" />

    <TextView
        android:id="@+id/SettingsPageItemHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:fontFamily="@font/inter"
        android:text="General"
        android:textColor="?BrushText"
        android:textSize="@dimen/EmBodyLg" />

    <TextView
        android:id="@+id/SettingsPageItemSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/inter"
        android:text=""
        android:textColor="?BrushTextSecondary"
        android:textSize="@dimen/EmBodySm"
        android:visibility="gone" />
</LinearLayout>
