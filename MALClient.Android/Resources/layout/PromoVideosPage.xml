<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?BrushDeepBackground">
  <GridView
      android:id="@+id/PromoVideosPageGridView"
      android:layout_width="match_parent"
      android:layout_centerInParent="true"
      android:layout_height="match_parent"
      android:numColumns="auto_fit"
      android:gravity="center"
      android:choiceMode="singleChoice"/>

  <ProgressBar android:id="@+id/PromoVideosPageLoadingSpinner" android:layout_width="wrap_content"
      android:indeterminateTint="?AccentColour" android:indeterminateTintMode="src_in"
      android:layout_height="wrap_content"
      android:indeterminate="true" android:layout_centerInParent="true"/>

  <RelativeLayout
      android:id="@+id/PromoVideosPageVideoOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#E6000000"
      android:visibility="gone">

    <WebView
        android:id="@+id/PromoVideosPageVideoWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/PromoVideosPageVideoCloseButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:background="@drawable/electric_midnight_circle_glass"
        android:padding="8dp"
        android:src="@drawable/icon_close"
        android:tint="@android:color/white" />
  </RelativeLayout>
</RelativeLayout>