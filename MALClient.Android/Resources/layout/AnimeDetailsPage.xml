<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <android.support.design.widget.CoordinatorLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <android.support.design.widget.AppBarLayout
        android:id="@+id/AnimeDetailsPageAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/EmSheet">

      <!-- Full hero: collapses on scroll down, re-expands on any upward drag -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          app:layout_scrollFlags="scroll">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="460dp"
            android:clipChildren="true">

          <FFImageLoading.Views.ImageViewAsync
              android:id="@+id/AnimeDetailsPageBlurredBackground"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:scaleType="centerCrop" />

          <FrameLayout
              android:id="@+id/AnimeDetailsPagePosterContainer"
              android:layout_width="340dp"
              android:layout_height="match_parent"
              android:layout_gravity="center_horizontal"
              android:layout_marginTop="5dp">

            <FFImageLoading.Views.ImageViewAsync
                android:id="@+id/AnimeDetailsPageShowCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter" />
          </FrameLayout>

          <View
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/hero_gradient_overlay" />

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="top|end"
              android:orientation="horizontal"
              android:gravity="end"
              android:padding="12dp">

            <ProgressBar
                android:id="@+id/AnimeDetailsPageLoadingUpdateSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:indeterminateTint="?AccentColour"
                android:indeterminateTintMode="src_in" />

            <ImageButton
                android:id="@+id/AnimeDetailsPageTrailerButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/electric_midnight_circle_glass"
                android:padding="8dp"
                android:src="@drawable/icon_video"
                android:tint="@android:color/white"
                android:visibility="gone" />
          </LinearLayout>

          <LinearLayout
              android:id="@+id/AnimeDetailsPageTitleSection"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_gravity="bottom"
              android:layout_marginStart="20dp"
              android:layout_marginEnd="20dp"
              android:layout_marginBottom="16dp"
              android:orientation="vertical">

            <TextView
                android:id="@+id/AnimeDetailsPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="#ffffff"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#b3000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="6"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Oshi no Ko" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

              <TextView
                  android:id="@+id/AnimeDetailsPageTypeBadge"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:background="@drawable/electric_midnight_type_badge"
                  android:paddingStart="8dp"
                  android:paddingEnd="8dp"
                  android:paddingTop="2dp"
                  android:paddingBottom="2dp"
                  android:fontFamily="@font/inter"
                  android:textColor="#ffffffff"
                  android:textSize="11sp"
                  android:textStyle="bold"
                  tools:text="Anime" />

              <TextView
                  android:id="@+id/AnimeDetailsPageAiringBadge"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:background="@drawable/electric_midnight_airing_badge"
                  android:paddingStart="6dp"
                  android:paddingEnd="6dp"
                  android:paddingTop="2dp"
                  android:paddingBottom="2dp"
                  android:fontFamily="@font/inter"
                  android:textColor="#ffffffff"
                  android:textSize="9sp"
                  android:textStyle="bold"
                  android:text="AIRING"
                  android:visibility="gone" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:layout_marginEnd="6dp"
                  android:textColor="#80ffffff"
                  android:textSize="11sp"
                  android:text="&#8226;" />

              <TextView
                  android:id="@+id/AnimeDetailsPageYearLabel"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:textColor="#ccffffff"
                  android:textSize="12sp"
                  tools:text="2023" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:layout_marginEnd="6dp"
                  android:textColor="#80ffffff"
                  android:textSize="11sp"
                  android:text="&#8226;" />

              <TextView
                  android:id="@+id/AnimeDetailsPageSubtitle"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:textColor="#ccffffff"
                  android:textSize="12sp"
                  tools:text="11 Episodes" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="24dp">

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:fontFamily="@font/inter"
                      android:text="SCORE"
                      android:textAllCaps="true"
                      android:letterSpacing="0.08"
                      android:textColor="#80ffffff"
                      android:textSize="10sp" />

                  <LinearLayout
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:orientation="horizontal"
                      android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/icon_star_filled"
                        android:tint="#FFD700" />

                    <TextView
                        android:id="@+id/AnimeDetailsPageScoreValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:textColor="#ffffff"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="8.74" />
                  </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                  <TextView
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:fontFamily="@font/inter"
                      android:text="STATUS"
                      android:textAllCaps="true"
                      android:letterSpacing="0.08"
                      android:textColor="#80ffffff"
                      android:textSize="10sp" />

                  <Button
                      android:id="@+id/AnimeDetailsPageStatusButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="1dp"
                      android:background="@android:color/transparent"
                      android:minWidth="0dp"
                      android:minHeight="0dp"
                      android:paddingStart="0dp"
                      android:paddingEnd="0dp"
                      android:paddingTop="0dp"
                      android:paddingBottom="0dp"
                      android:textAllCaps="false"
                      android:textColor="#ffffff"
                      android:textSize="15sp"
                      android:textStyle="bold" />
                </LinearLayout>
              </LinearLayout>

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:gravity="center_vertical"
                  android:orientation="horizontal"
                  android:background="@drawable/electric_midnight_pill"
                  android:padding="4dp">

                <FrameLayout
                    android:id="@+id/AnimeDetailsPageDecrementButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:selectableItemBackground">

                  <ImageView
                      android:layout_width="match_parent"
                      android:layout_height="match_parent"
                      android:background="@drawable/electric_midnight_circle_dark"
                      android:padding="8dp"
                      android:src="@drawable/icon_minus"
                      android:tint="#80ffffff" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:minWidth="56dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                  <TextView
                      android:id="@+id/AnimeDetailsPageWatchedLabel"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:fontFamily="@font/inter"
                      android:text="EP"
                      android:textAllCaps="true"
                      android:letterSpacing="0.08"
                      android:textColor="#80ffffff"
                      android:textSize="10sp" />

                  <Button
                      android:id="@+id/AnimeDetailsPageWatchedButton"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:fontFamily="@font/inter"
                      android:textColor="#ffffff"
                      android:textSize="16sp"
                      android:textStyle="bold"
                      android:gravity="center"
                      android:background="@android:color/transparent"
                      android:minWidth="0dp"
                      android:minHeight="0dp"
                      android:paddingStart="4dp"
                      android:paddingEnd="4dp"
                      android:paddingTop="0dp"
                      android:paddingBottom="0dp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/AnimeDetailsPageIncrementButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:selectableItemBackground">

                  <ImageView
                      android:layout_width="match_parent"
                      android:layout_height="match_parent"
                      android:background="@drawable/electric_midnight_circle_primary"
                      android:padding="8dp"
                      android:src="@drawable/icon_add"
                      android:tint="@android:color/white" />
                </FrameLayout>
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>

          <RelativeLayout
              android:id="@+id/AnimeDetailsPageIncDecSection"
              android:layout_width="wrap_content"
              android:layout_height="match_parent"
              android:visibility="gone" />

          <FrameLayout
              android:id="@+id/AnimeDetailsPageAddButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone" />

          <Button
              android:id="@+id/AnimeDetailsPageScoreButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone"
              android:text="" />

          <Button
              android:id="@+id/AnimeDetailsPageReadVolumesButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone"
              android:text="" />

          <TextView
              android:id="@+id/AnimeDetailsPageReadVolumesLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/AnimeDetailsPageUpdateSection"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/AnimeDetailsPageFavouriteButton"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
      </LinearLayout>

      <!-- Quick Actions: pinned -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="@drawable/electric_midnight_sheet_top"
          android:orientation="horizontal"
          android:paddingTop="8dp"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:paddingBottom="8dp">

        <Button
            android:id="@+id/AnimeDetailsPageQuickAddToListButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="3dp"
            android:layout_weight="1"
            android:background="@drawable/electric_midnight_action_button"
            android:drawableStart="@drawable/icon_circle_add"
            android:drawablePadding="8dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Add to List"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <Button
            android:id="@+id/AnimeDetailsPageQuickFavoriteButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:background="@drawable/electric_midnight_action_button"
            android:drawableStart="@drawable/icon_heart_outline"
            android:drawablePadding="8dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Favorite"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/AnimeDetailsPageMoreButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/electric_midnight_action_button"
            android:padding="10dp"
            android:src="@drawable/icon_more_vertical"
            android:tint="#ffffff" />
      </LinearLayout>

      <!-- Tab strip: pinned -->
      <MALClient.Android.UserControls.PagerSlidingTabStrip
          android:id="@+id/AnimeDetailsPageTabStrip"
          android:layout_width="match_parent"
          android:layout_height="40dp"
          android:background="@color/EmSheet"
          android:textColorPrimary="#ffffff"
          android:textColorSecondary="?BrushTextAccentContrast" />
    </android.support.design.widget.AppBarLayout>

    <!-- Pager fills ALL remaining space; pull-to-refresh asks the visible tab -->
    <MALClient.Android.UserControls.ScrollableSwipeToRefreshLayout
        android:id="@+id/AnimeDetailsPageSwipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

      <MALClient.Android.UserControls.HeightAdjustingViewPager
          android:id="@+id/AnimeDetailsPagePivot"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@color/EmSheet" />
    </MALClient.Android.UserControls.ScrollableSwipeToRefreshLayout>
  </android.support.design.widget.CoordinatorLayout>

  <!-- Mini hero: overlay shown while the full hero is collapsed.
       Positioned outside AppBarLayout so it does NOT affect layout heights.
       marginTop=96dp ≈ quick-actions(~56dp) + tab-strip(40dp). -->
  <FrameLayout
      android:id="@+id/AnimeDetailsPageCompactBar"
      android:layout_width="match_parent"
      android:layout_height="190dp"
      android:layout_gravity="top"
      android:layout_marginTop="96dp"
      android:background="@color/EmSheet"
      android:elevation="4dp"
      android:visibility="gone">

    <FFImageLoading.Views.ImageViewAsync
        android:id="@+id/AnimeDetailsPageCompactBlurredBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_gradient_overlay" />

    <FrameLayout
        android:id="@+id/AnimeDetailsPageCompactPosterContainer"
        android:layout_width="112dp"
        android:layout_height="164dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="12dp">

      <FFImageLoading.Views.ImageViewAsync
          android:id="@+id/AnimeDetailsPageCompactShowCoverImage"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="140dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:orientation="vertical">

      <TextView
          android:id="@+id/AnimeDetailsPageCompactTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:textColor="#ffffff"
          android:textSize="15sp"
          android:textStyle="bold"
          android:maxLines="1"
          android:ellipsize="end"
          tools:text="Oshi no Ko" />

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="2dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <TextView
            android:id="@+id/AnimeDetailsPageCompactTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_type_badge"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:fontFamily="@font/inter"
            android:textColor="#ffffffff"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="TV" />

        <TextView
            android:id="@+id/AnimeDetailsPageCompactAiringBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/electric_midnight_airing_badge"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:fontFamily="@font/inter"
            android:textColor="#ffffffff"
            android:textSize="9sp"
            android:textStyle="bold"
            android:text="AIRING"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#80ffffff"
            android:textSize="10sp"
            android:text="&#8226;" />

        <TextView
            android:id="@+id/AnimeDetailsPageCompactYearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="#ccffffff"
            android:textSize="11sp"
            tools:text="2023" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:textColor="#80ffffff"
            android:textSize="10sp"
            android:text="&#8226;" />

        <TextView
            android:id="@+id/AnimeDetailsPageCompactEpisodesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="#ccffffff"
            android:textSize="11sp"
            tools:text="11 Episodes" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:orientation="horizontal"
          android:gravity="center_vertical">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/icon_star_filled"
            android:tint="#FFD700" />

        <TextView
            android:id="@+id/AnimeDetailsPageCompactScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="12dp"
            android:fontFamily="@font/inter"
            android:textColor="#FFD700"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="8.74" />

        <TextView
            android:id="@+id/AnimeDetailsPageCompactStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:textColor="#ffffff"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Watching" />
      </LinearLayout>

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:background="@drawable/electric_midnight_pill"
          android:padding="3dp">

        <FrameLayout
            android:id="@+id/AnimeDetailsPageCompactDecrementButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:selectableItemBackground">

          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/electric_midnight_circle_dark"
              android:padding="7dp"
              android:src="@drawable/icon_minus"
              android:tint="#80ffffff" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:minWidth="44dp"
            android:paddingStart="3dp"
            android:paddingEnd="3dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="EP"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="#80ffffff"
              android:textSize="8sp" />

          <Button
              android:id="@+id/AnimeDetailsPageCompactWatchedButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:textColor="#ffffff"
              android:textSize="14sp"
              android:textStyle="bold"
              android:gravity="center"
              android:background="@android:color/transparent"
              android:minWidth="0dp"
              android:minHeight="0dp"
              android:paddingStart="2dp"
              android:paddingEnd="2dp"
              android:paddingTop="0dp"
              android:paddingBottom="0dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/AnimeDetailsPageCompactIncrementButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:selectableItemBackground">

          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="@drawable/electric_midnight_circle_primary"
              android:padding="7dp"
              android:src="@drawable/icon_add"
              android:tint="@android:color/white" />
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>
  </FrameLayout>

  <RelativeLayout
      android:id="@+id/AnimeDetailsPageLoadingOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="?BrushLoading"
      android:elevation="10dp"
      android:visibility="gone">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="?AccentColour"
        android:indeterminateTintMode="src_in" />
  </RelativeLayout>

  <RelativeLayout
      android:id="@+id/AnimeDetailsPageVideoOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="#E6000000"
      android:elevation="10dp"
      android:visibility="gone">

    <WebView
        android:id="@+id/AnimeDetailsPageVideoWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageButton
        android:id="@+id/AnimeDetailsPageVideoCloseButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:background="@drawable/electric_midnight_circle_glass"
        android:padding="8dp"
        android:src="@drawable/icon_close"
