<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_alignParentStart="true"
      android:layout_alignParentTop="true"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:paddingBottom="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:elevation="2dp">

          <FrameLayout
              android:id="@+id/ImageContainer"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

            <FFImageLoading.Views.ImageViewAsync
                android:id="@+id/AnimeDetailsPageShowCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_gradient_overlay" />
          </FrameLayout>

          <!-- Floating Stats section with quick actions -->
          <LinearLayout
              android:id="@+id/AnimeDetailsPageUpdateSection"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_alignParentBottom="true"
              android:layout_margin="16dp"
              android:background="@drawable/electric_midnight_glass_panel"
              android:orientation="horizontal"
              android:padding="16dp">

            <!-- Score column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:text="Score"
                  android:textColor="?BrushTextAccentContrast"
                  android:textSize="12sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/AnimeDetailsPageScoreValue"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:text="8.74"
                  android:textColor="?BrushText"
                  android:textSize="20sp"
                  android:textStyle="bold" />
            </LinearLayout>

            <!-- Status column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:text="Status"
                  android:textColor="?BrushTextAccentContrast"
                  android:textSize="12sp"
                  android:textStyle="bold" />

              <Button
                  android:id="@+id/AnimeDetailsPageStatusButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:background="@drawable/electric_midnight_glass_button"
                  android:minWidth="60dp"
                  android:padding="4dp"
                  android:text="Finished"
                  android:textAllCaps="false"
                  android:textColor="?BrushText"
                  android:textSize="14sp" />
            </LinearLayout>

            <!-- Watched/Episodes column -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical">

              <TextView
                  android:id="@+id/AnimeDetailsPageWatchedLabel"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="5dp"
                  android:fontFamily="@font/inter"
                  android:gravity="center"
                  android:maxWidth="60dp"
                  android:minHeight="25dp"
                  android:text="Watched episodes"
                  android:textColor="?BrushText"
                  android:textSize="11sp" />

              <TextView
                  android:id="@+id/AnimeDetailsPageReadVolumesLabel"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="5dp"
                  android:fontFamily="@font/inter"
                  android:gravity="center"
                  android:minHeight="25dp"
                  android:text="Volumes"
                  android:textColor="?BrushText"
                  android:textSize="11sp"
                  android:visibility="gone" />
            </LinearLayout>

            <!-- Episode controls (inc/dec) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="15dp"
                android:orientation="vertical">

              <Button
                  android:id="@+id/AnimeDetailsPageScoreButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="3dp"
                  android:background="@drawable/electric_midnight_glass_button"
                  android:clickable="true"
                  android:minWidth="40dp"
                  android:padding="4dp"
                  android:text="8.74"
                  android:textAllCaps="false"
                  android:textColor="?BrushText" />

              <Button
                  android:id="@+id/AnimeDetailsPageWatchedButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="5dp"
                  android:background="@drawable/electric_midnight_glass_button"
                  android:minWidth="40dp"
                  android:padding="4dp"
                  android:text="11/11"
                  android:textAllCaps="false"
                  android:textColor="?BrushText" />

              <Button
                  android:id="@+id/AnimeDetailsPageReadVolumesButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="5dp"
                  android:background="@drawable/electric_midnight_glass_button"
                  android:minWidth="40dp"
                  android:padding="4dp"
                  android:text="Vol"
                  android:textAllCaps="false"
                  android:textColor="?BrushText"
                  android:visibility="gone" />
            </LinearLayout>
          </LinearLayout>

          <!-- Inc Dec section -->
          <RelativeLayout
              android:id="@+id/AnimeDetailsPageIncDecSection"
              android:layout_width="wrap_content"
              android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="vertical"
                android:padding="10dp">

              <FrameLayout
                  android:id="@+id/AnimeDetailsPageIncrementButton"
                  android:layout_width="@dimen/IncrementDecrementButtonWidth"
                  android:layout_height="@dimen/IncrementDecrementButtonWidth"
                  android:clickable="true"
                  android:focusable="true"
                  android:foreground="?android:selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:background="@drawable/electric_midnight_glass_button"
                    android:padding="8dp"
                    android:src="@drawable/icon_add"
                    android:tint="?BrushText" />
              </FrameLayout>

              <FrameLayout
                  android:id="@+id/AnimeDetailsPageDecrementButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="10dp"
                  android:clickable="true"
                  android:focusable="true"
                  android:foreground="?android:selectableItemBackground">

                <ImageView
                    android:layout_width="@dimen/IncrementDecrementButtonWidth"
                    android:layout_height="@dimen/IncrementDecrementButtonWidth"
                    android:background="@drawable/electric_midnight_glass_button"
                    android:padding="8dp"
                    android:src="@drawable/icon_minus"
                    android:tint="?BrushText" />
              </FrameLayout>
            </LinearLayout>
          </RelativeLayout>

          <!-- Favourite and More buttons -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentBottom="true"
              android:layout_alignParentEnd="true"
              android:orientation="horizontal"
              android:padding="12dp">

            <ProgressBar
                android:id="@+id/AnimeDetailsPageLoadingUpdateSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerInParent="true"
                android:indeterminate="true"
                android:indeterminateTint="?AccentColour"
                android:indeterminateTintMode="src_in" />

            <ImageButton
                android:id="@+id/AnimeDetailsPageFavouriteButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/electric_midnight_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/icon_favourite"
                android:tint="?BrushText" />

            <ImageButton
                android:id="@+id/AnimeDetailsPageMoreButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/electric_midnight_glass_button"
                android:padding="8dp"
                android:src="@drawable/icon_more_vertical"
                android:tint="?BrushText" />
          </LinearLayout>

          <!-- Add to my list button -->
          <LinearLayout
              android:id="@+id/AnimeDetailsPageAddSection"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentBottom="true"
              android:layout_alignParentEnd="true"
              android:layout_gravity="bottom"
              android:layout_margin="16dp"
              android:gravity="center"
              android:orientation="horizontal"
              android:padding="12dp"
              android:visibility="gone">

            <FrameLayout
                android:id="@+id/AnimeDetailsPageAddButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/electric_midnight_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:gravity="center"
                  android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_add"
                    android:tint="?BrushText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter"
                    android:text="Add to my list"
                    android:textColor="?BrushText"
                    android:textSize="14sp" />
              </LinearLayout>
            </FrameLayout>
          </LinearLayout>
        </RelativeLayout>
      </FrameLayout>

      <!-- Quick Actions (Add to List, Favorite) - floating below hero -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="-24dp"
          android:layout_marginStart="16dp"
          android:layout_marginEnd="16dp"
          android:layout_marginBottom="8dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:padding="12dp">

        <Button
            android:id="@+id/AnimeDetailsPageQuickAddToListButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/electric_midnight_glass_button"
            android:fontFamily="@font/inter"
            android:padding="10dp"
            android:text="Add to List"
            android:textAllCaps="false"
            android:textColor="?BrushText"
            android:textSize="14sp" />

        <Button
            android:id="@+id/AnimeDetailsPageQuickFavoriteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/electric_midnight_glass_button"
            android:fontFamily="@font/inter"
            android:padding="10dp"
            android:text="Favorite"
            android:textAllCaps="false"
            android:textColor="?BrushText"
            android:textSize="14sp" />
      </LinearLayout>

      <MALClient.Android.UserControls.PagerSlidingTabStrip
          android:id="@+id/AnimeDetailsPageTabStrip"
          android:layout_width="match_parent"
          android:layout_height="40dp"
          android:layout_marginStart="16dp"
          android:layout_marginEnd="16dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:textColorPrimary="?AccentColour"
          android:textColorSecondary="?BrushTextAccentContrast" />

      <MALClient.Android.UserControls.HeightAdjustingViewPager
          android:id="@+id/AnimeDetailsPagePivot"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?BrushDetailsBackground" />
    </LinearLayout>
  </ScrollView>

  <RelativeLayout
      android:id="@+id/AnimeDetailsPageLoadingOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="?BrushLoading"
      android:visibility="gone">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="?AccentColour"
        android:indeterminateTintMode="src_in" />
  </RelativeLayout>
</RelativeLayout>
