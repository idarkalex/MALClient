<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_alignParentStart="true"
      android:layout_alignParentTop="true"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

      <!-- Hero Section -->
      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:clipToPadding="false"
          android:paddingBottom="2dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:elevation="2dp">

          <FrameLayout
              android:id="@+id/ImageContainer"
              android:layout_width="match_parent"
              android:layout_height="match_parent">

            <FFImageLoading.Views.ImageViewAsync
                android:id="@+id/AnimeDetailsPageShowCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_gradient_overlay" />
          </FrameLayout>

          <!-- Floating back & more buttons at top -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_alignParentTop="true"
              android:orientation="horizontal"
              android:gravity="end"
              android:padding="12dp">

            <ProgressBar
                android:id="@+id/AnimeDetailsPageLoadingUpdateSpinner"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:indeterminate="true"
                android:indeterminateTint="?AccentColour"
                android:indeterminateTintMode="src_in" />

            <ImageButton
                android:id="@+id/AnimeDetailsPageFavouriteButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="8dp"
                android:background="@drawable/electric_midnight_circle_glass"
                android:clickable="true"
                android:focusable="true"
                android:padding="8dp"
                android:src="@drawable/icon_heart_outline"
                android:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/AnimeDetailsPageMoreButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/electric_midnight_circle_glass"
                android:padding="8dp"
                android:src="@drawable/icon_more_vertical"
                android:tint="@android:color/white" />
          </LinearLayout>

          <!-- Title & Subtitle overlaid on hero poster -->
          <LinearLayout
              android:id="@+id/AnimeDetailsPageTitleSection"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_above="@id/AnimeDetailsPageUpdateSection"
              android:layout_marginStart="20dp"
              android:layout_marginEnd="20dp"
              android:layout_marginBottom="8dp"
              android:orientation="vertical">

            <TextView
                android:id="@+id/AnimeDetailsPageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="#ffffff"
                android:textSize="24sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="4"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Oshi no Ko" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

              <!-- Type badge pill -->
              <TextView
                  android:id="@+id/AnimeDetailsPageTypeBadge"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:background="@drawable/electric_midnight_badge"
                  android:paddingStart="8dp"
                  android:paddingEnd="8dp"
                  android:paddingTop="2dp"
                  android:paddingBottom="2dp"
                  android:fontFamily="@font/inter"
                  android:textColor="#ffffffff"
                  android:textSize="11sp"
                  android:textStyle="bold"
                  tools:text="TV" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:layout_marginEnd="6dp"
                  android:textColor="#80ffffff"
                  android:textSize="11sp"
                  android:text="•" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:textColor="#ccffffff"
                  android:textSize="12sp"
                  tools:text="2023" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="6dp"
                  android:layout_marginEnd="6dp"
                  android:textColor="#80ffffff"
                  android:textSize="11sp"
                  android:text="•" />

              <TextView
                  android:id="@+id/AnimeDetailsPageSubtitle"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:textColor="#ccffffff"
                  android:textSize="12sp"
                  tools:text="11 Episodes" />
            </LinearLayout>
          </LinearLayout>

          <!-- Floating Update Section (glass pill) -->
          <LinearLayout
              android:id="@+id/AnimeDetailsPageUpdateSection"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_alignParentBottom="true"
              android:layout_marginStart="16dp"
              android:layout_marginEnd="16dp"
              android:layout_marginBottom="16dp"
              android:background="@drawable/electric_midnight_update_panel"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingStart="16dp"
              android:paddingEnd="8dp"
              android:paddingTop="12dp"
              android:paddingBottom="12dp">

            <!-- Score column with star -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

              <ImageView
                  android:layout_width="18dp"
                  android:layout_height="18dp"
                  android:layout_marginEnd="6dp"
                  android:src="@drawable/icon_star_filled"
                  android:tint="#FFD700" />

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="SCORE"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textColor="#80ffffff"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/AnimeDetailsPageScoreValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/inter"
                    android:text=""
                    android:textColor="#ffffff"
                    android:textSize="18sp"
                    android:textStyle="bold" />
              </LinearLayout>
            </LinearLayout>

            <!-- Status column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:fontFamily="@font/inter"
                  android:text="STATUS"
                  android:textAllCaps="true"
                  android:letterSpacing="0.08"
                  android:textColor="#80ffffff"
                  android:textSize="10sp" />

              <Button
                  android:id="@+id/AnimeDetailsPageStatusButton"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="1dp"
                  android:background="@android:color/transparent"
                  android:minWidth="0dp"
                  android:minHeight="0dp"
                  android:paddingStart="0dp"
                  android:paddingEnd="0dp"
                  android:paddingTop="0dp"
                  android:paddingBottom="0dp"
                  android:text="Finished"
                  android:textAllCaps="false"
                  android:textColor="#ffffff"
                  android:textSize="15sp"
                  android:textStyle="bold" />
            </LinearLayout>

            <!-- Episode stepper pill -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/electric_midnight_pill"
                android:padding="4dp">

              <FrameLayout
                  android:id="@+id/AnimeDetailsPageDecrementButton"
                  android:layout_width="36dp"
                  android:layout_height="36dp"
                  android:clickable="true"
                  android:focusable="true"
                  android:foreground="?android:selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/electric_midnight_circle_dark"
                    android:padding="8dp"
                    android:src="@drawable/icon_minus"
                    android:tint="#80ffffff" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="center"
                  android:minWidth="56dp"
                  android:paddingStart="4dp"
                  android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/AnimeDetailsPageWatchedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="EP"
                    android:textAllCaps="true"
                    android:letterSpacing="0.08"
                    android:textColor="#80ffffff"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/AnimeDetailsPageWatchedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="11/11"
                    android:textColor="#ffffff"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp" />
              </LinearLayout>

              <FrameLayout
                  android:id="@+id/AnimeDetailsPageIncrementButton"
                  android:layout_width="36dp"
                  android:layout_height="36dp"
                  android:clickable="true"
                  android:focusable="true"
                  android:foreground="?android:selectableItemBackground">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/electric_midnight_circle_primary"
                    android:padding="8dp"
                    android:src="@drawable/icon_add"
                    android:tint="@android:color/white" />
              </FrameLayout>
            </LinearLayout>
          </LinearLayout>

          <!-- Hidden Inc Dec section (kept for code compat, invisible) -->
          <RelativeLayout
              android:id="@+id/AnimeDetailsPageIncDecSection"
              android:layout_width="wrap_content"
              android:layout_height="match_parent"
              android:visibility="gone" />

          <!-- Add to my list button (hidden by default) -->
          <LinearLayout
              android:id="@+id/AnimeDetailsPageAddSection"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentBottom="true"
              android:layout_alignParentEnd="true"
              android:layout_gravity="bottom"
              android:layout_margin="16dp"
              android:gravity="center"
              android:orientation="horizontal"
              android:padding="12dp"
              android:visibility="gone">

            <FrameLayout
                android:id="@+id/AnimeDetailsPageAddButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/electric_midnight_glass_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="8dp">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:gravity="center"
                  android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/icon_add"
                    android:tint="?BrushText" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/inter"
                    android:text="Add to my list"
                    android:textColor="?BrushText"
                    android:textSize="@dimen/EmBodyMd" />
              </LinearLayout>
            </FrameLayout>
          </LinearLayout>

          <!-- Score button (hidden, kept for code compat) -->
          <Button
              android:id="@+id/AnimeDetailsPageScoreButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone"
              android:text="" />

          <!-- Volumes button (hidden, kept for code compat) -->
          <Button
              android:id="@+id/AnimeDetailsPageReadVolumesButton"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone"
              android:text="" />

          <!-- Read Volumes Label (hidden, kept for code compat) -->
          <TextView
              android:id="@+id/AnimeDetailsPageReadVolumesLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:visibility="gone" />
        </RelativeLayout>
      </FrameLayout>

      <!-- Quick Actions (Add to List, Favorite) - glass panel below hero -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="-16dp"
          android:layout_marginStart="16dp"
          android:layout_marginEnd="16dp"
          android:layout_marginBottom="8dp"
          android:background="@drawable/electric_midnight_update_panel"
          android:orientation="horizontal"
          android:padding="4dp">

        <Button
            android:id="@+id/AnimeDetailsPageQuickAddToListButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/electric_midnight_action_button"
            android:drawableStart="@drawable/icon_circle_add"
            android:drawablePadding="6dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="Add to List"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="13sp" />

        <Button
            android:id="@+id/AnimeDetailsPageQuickFavoriteButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:background="@drawable/electric_midnight_action_button"
            android:drawableStart="@drawable/icon_heart_outline"
            android:drawablePadding="6dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="Favorite"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textSize="13sp" />
      </LinearLayout>

      <MALClient.Android.UserControls.PagerSlidingTabStrip
          android:id="@+id/AnimeDetailsPageTabStrip"
          android:layout_width="match_parent"
          android:layout_height="40dp"
          android:layout_marginStart="16dp"
          android:layout_marginEnd="16dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:textColorPrimary="?AccentColour"
          android:textColorSecondary="?BrushTextAccentContrast" />

      <MALClient.Android.UserControls.HeightAdjustingViewPager
          android:id="@+id/AnimeDetailsPagePivot"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:background="?BrushDetailsBackground" />
    </LinearLayout>
  </ScrollView>

  <RelativeLayout
      android:id="@+id/AnimeDetailsPageLoadingOverlay"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="?BrushLoading"
      android:visibility="gone">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="?AccentColour"
        android:indeterminateTintMode="src_in" />
  </RelativeLayout>
</RelativeLayout>
