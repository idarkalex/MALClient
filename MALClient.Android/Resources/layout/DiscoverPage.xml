<?xml version="1.0" encoding="utf-8"?>
<MALClient.Android.UserControls.ScrollableSwipeToRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/DiscoverPageRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?BrushDeepBackground">

  <ScrollView
      android:id="@+id/DiscoverPageScroll"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="?BrushDeepBackground"
      android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingTop="4dp"
      android:paddingBottom="8dp">

    <ProgressBar
        android:id="@+id/DiscoverPageLoadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="48dp"
        android:indeterminateTint="?AccentColour"
        android:visibility="gone" />

    <TextView
        android:id="@+id/DiscoverLoginPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="16dp"
        android:gravity="center_horizontal"
        android:text="Sign in to see your anime and manga lists"
        android:textColor="?BrushText"
        android:textSize="@dimen/FontSizeMedium"
        android:visibility="gone" />

    <TextView
        android:id="@+id/DiscoverLoginButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="?android:selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:text="Sign in"
        android:textColor="?AccentColour"
        android:textSize="@dimen/FontSizeBig"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverWatchingHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Continue watching"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverWatchingSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverWatchingRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverReadingHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Reading"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverReadingSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverReadingRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverCompletedHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Completed"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverCompletedSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverCompletedRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <!-- Suggestions (auth-gated) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverSuggestionsHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="For you"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverSuggestionsSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverSuggestionsRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverSeasonalHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Seasonal"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverSeasonalSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverSeasonalRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <!-- Upcoming season -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverUpcomingHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Upcoming"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverUpcomingSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverUpcomingRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverTopAnimeHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Top anime"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverTopAnimeSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverTopAnimeRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverTopMangaHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Top manga"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverTopMangaSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverTopMangaRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverAdaptedHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Adapted to anime"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverAdaptedSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverAdaptedRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <!-- Featured articles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverFeaturedHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="Featured"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverFeaturedSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverFeaturedRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="8dp"
        android:gravity="center_vertical">
      <TextView
          android:id="@+id/DiscoverNewsHeader"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:fontFamily="@font/inter"
          android:text="News"
          android:textColor="?AccentColour"
          android:textSize="@dimen/FontSizeBig" />
      <TextView
          android:id="@+id/DiscoverNewsSeeAll"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="See all"
          android:textColor="?AccentColourDark"
          android:textSize="@dimen/FontSizeMedium"
          android:clickable="true"
          android:focusable="true"
          android:padding="4dp"
          android:foreground="?android:selectableItemBackground" />
    </LinearLayout>    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">
      <LinearLayout
          android:id="@+id/DiscoverNewsRow"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:paddingLeft="4dp"
          android:paddingRight="4dp" />
    </HorizontalScrollView>

  </LinearLayout>
  </ScrollView>
</MALClient.Android.UserControls.ScrollableSwipeToRefreshLayout>

