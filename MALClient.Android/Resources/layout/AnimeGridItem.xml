<?xml version="1.0" encoding="UTF-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/GridCardWidth"
    android:layout_height="@dimen/GridCardHeight"
    android:layout_gravity="center_horizontal"
    android:layout_margin="@dimen/GridCardMargin"
    android:foreground="?android:selectableItemBackground">

  <!-- Poster image fills the entire card -->
  <FFImageLoading.Views.ImageViewAsync
      android:id="@+id/AnimeGridItemImage"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:adjustViewBounds="true"
      android:scaleType="centerCrop"
      android:background="?BrushAppBars"
      tools:src="@drawable/annak" />

  <!-- Loading spinner centered -->
  <ProgressBar
      android:id="@+id/AnimeGridItemImgPlaceholder"
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:layout_gravity="center"
      android:indeterminate="true"
      android:indeterminateTint="?BrushAnimeItemBackground"
      android:indeterminateTintMode="src_in" />

  <!-- Title at bottom with dark gradient background -->
  <TextView
      android:id="@+id/AnimeGridItemTitle"
      style="@style/GridCardTitleStyle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom"
      android:textColor="#ffffff" />

</FrameLayout>
