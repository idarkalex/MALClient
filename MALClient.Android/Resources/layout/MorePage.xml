<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?BrushDeepBackground"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingBottom="24dp">

    <!-- Profile Header -->
    <LinearLayout
        android:id="@+id/MorePageProfileHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/electric_midnight_glass_panel"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

      <FrameLayout
          android:layout_width="56dp"
          android:layout_height="56dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/icon_account" />

        <FFImageLoading.Views.ImageViewAsync
            android:id="@+id/MorePageProfileImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />
      </FrameLayout>

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="16dp"
          android:layout_weight="1"
          android:orientation="vertical">

        <TextView
            android:id="@+id/MorePageProfileUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="Username"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmTitleMd"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/MorePageProfileCompleted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:text="0 Completed"
            android:textColor="?BrushTextSecondary"
            android:textSize="@dimen/EmBodyMd" />
      </LinearLayout>

      <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:src="@drawable/icon_go"
          android:tint="?BrushTextSecondary" />
    </LinearLayout>

    <!-- Anime Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <View
          android:layout_width="3dp"
          android:layout_height="14dp"
          android:background="?AccentColour" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:letterSpacing="0.08"
          android:paddingStart="8dp"
          android:text="Anime"
          android:textAllCaps="true"
          android:textColor="?AccentColour"
          android:textSize="@dimen/EmLabelCaps"
          android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/MorePageAnimeList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/electric_midnight_glass_panel"
        android:orientation="vertical">

      <LinearLayout
          android:id="@+id/MorePageAnimeListItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_list"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Anime list"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_more_vertical"
            android:tint="?BrushTextSecondary" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageSeasonalItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_seasonal"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Seasonal anime"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageTopAnimeItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_fav_outline"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Top anime"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_more_vertical"
            android:tint="?BrushTextSecondary" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageSearchItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_search"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Search"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageRecommendationsItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_recom"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Recommendations"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageCalendarItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_calendar"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Calendar"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>
    </LinearLayout>

    <!-- Manga Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <View
          android:layout_width="3dp"
          android:layout_height="14dp"
          android:background="?AccentColour" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:letterSpacing="0.08"
          android:paddingStart="8dp"
          android:text="Manga"
          android:textAllCaps="true"
          android:textColor="?AccentColour"
          android:textSize="@dimen/EmLabelCaps"
          android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/MorePageMangaSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/electric_midnight_glass_panel"
        android:orientation="vertical">

      <LinearLayout
          android:id="@+id/MorePageMangaListItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_list"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Manga list"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_more_vertical"
            android:tint="?BrushTextSecondary" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageTopMangaItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_fav_outline"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Top manga"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_more_vertical"
            android:tint="?BrushTextSecondary" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageAdaptedItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_books"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Adapted to anime"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_more_vertical"
            android:tint="?BrushTextSecondary" />
      </LinearLayout>
    </LinearLayout>

    <!-- Other Section -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

      <View
          android:layout_width="3dp"
          android:layout_height="14dp"
          android:background="?AccentColour" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:letterSpacing="0.08"
          android:paddingStart="8dp"
          android:text="Other"
          android:textAllCaps="true"
          android:textColor="?AccentColour"
          android:textSize="@dimen/EmLabelCaps"
          android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/electric_midnight_glass_panel"
        android:orientation="vertical">

      <LinearLayout
          android:id="@+id/MorePageArticlesItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_newspaper"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Articles &amp; News"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageVideosItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_video"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Promotional Videos"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageForumsItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_forum"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Forums"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginStart="56dp"
          android:background="#1affffff" />

      <LinearLayout
          android:id="@+id/MorePageSettingsItem"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:clickable="true"
          android:focusable="true"
          android:foreground="?selectableItemBackground"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingStart="16dp"
          android:paddingEnd="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_settings"
            android:tint="?BrushTextSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="Settings &amp; more"
            android:textColor="?BrushText"
            android:textSize="@dimen/EmBodyLg" />
      </LinearLayout>
    </LinearLayout>

  </LinearLayout>
</ScrollView>
