<MALClient.Android.UserControls.OrientationDependentScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?BrushDetailsBackground"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingEnd="12dp">

    <!-- Bento grid: 2 columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

      <!-- Left column -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginEnd="4dp"
          android:orientation="vertical">

        <!-- Episodes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_glass_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="Episodes"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <TextView
                android:id="@+id/AnimeDetailsPageGeneralTabFragmentEpisodesLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Episodes"
                android:textColor="?BrushText"
                android:textSize="@dimen/FontSizeNormal" />

            <TextView
                android:id="@+id/AnimeDetailsPageGeneralTabFragmentEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="?BrushText"
                android:textSize="@dimen/FontSizeNormal"
                android:textStyle="bold" />
          </LinearLayout>
        </LinearLayout>

        <!-- Score -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_glass_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="Score"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <FrameLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/AnimeDetailsPageGeneralTabFragmentScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:textColor="?BrushText"
                android:textSize="@dimen/EmTitleMd"
                android:textStyle="bold"
                tools:text="8.44" />

            <LinearLayout
                android:id="@+id/AnimeDetailsPageGeneralTabFragmentScoreHiddenLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center_vertical"
                android:visibility="gone">

              <ImageView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:src="@drawable/icon_eye_outline" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:fontFamily="@font/inter"
                  android:text="Hidden"
                  android:textColor="?BrushTextSecondary"
                  android:textSize="@dimen/FontSizeNormal"
                  android:textStyle="italic" />
            </LinearLayout>
          </FrameLayout>
        </LinearLayout>

        <!-- Start date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_glass_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="Start"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentStart"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/FontSizeNormal" />
        </LinearLayout>

        <!-- My Start (clickable) -->
        <FrameLayout
            android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyStartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:selectableItemBackground"
            android:longClickable="true"
            android:layout_marginBottom="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/electric_midnight_glass_panel"
              android:orientation="vertical"
              android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="My start"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?BrushTextSecondary"
                android:textSize="@dimen/EmLabelCaps" />

            <TextView
                android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:textColor="?AccentColour"
                android:textSize="@dimen/FontSizeNormal" />
          </LinearLayout>
        </FrameLayout>
      </LinearLayout>

      <!-- Right column -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:orientation="vertical">

        <!-- Type -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_glass_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="Type"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentType"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/FontSizeNormal"
              android:textStyle="bold" />
        </LinearLayout>

        <!-- Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_glass_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="Status"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentStatus"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/FontSizeNormal"
              android:textStyle="bold" />
        </LinearLayout>

        <!-- End date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/electric_midnight_glass_panel"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="8dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="End"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentEnd"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/FontSizeNormal" />
        </LinearLayout>

        <!-- My End (clickable) -->
        <FrameLayout
            android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyEndButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:selectableItemBackground"
            android:longClickable="true"
            android:layout_marginBottom="8dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:background="@drawable/electric_midnight_glass_panel"
              android:orientation="vertical"
              android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="My end"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="?BrushTextSecondary"
                android:textSize="@dimen/EmLabelCaps" />

            <TextView
                android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/inter"
                android:textColor="?AccentColour"
                android:textSize="@dimen/FontSizeNormal" />
          </LinearLayout>
        </FrameLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- Synopsis glass panel with fade -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/electric_midnight_glass_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:text="Synopsis"
          android:textAllCaps="true"
          android:letterSpacing="0.08"
          android:textColor="?BrushTextSecondary"
          android:textSize="@dimen/EmLabelCaps" />

      <TextView
          android:id="@+id/AnimeDetailsPageGeneralTabFragmentSynopsis"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:fontFamily="@font/inter"
          android:lineSpacingMultiplier="1.4"
          android:text=""
          android:textColor="?BrushText"
          android:textSize="@dimen/FontSizeNormal" />
    </LinearLayout>

  </LinearLayout>
</MALClient.Android.UserControls.OrientationDependentScrollView>
