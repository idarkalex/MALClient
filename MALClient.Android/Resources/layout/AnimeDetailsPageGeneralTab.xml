<android.support.v4.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/EmSheet"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="12dp"
      android:paddingEnd="12dp">

    <!-- Row 1: Rank + Popularity (50/50) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

      <!-- Rank card -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginEnd="4dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_trophy"
            android:tint="#FFD700" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="RANK"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentEpisodesLabel"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/EmTitleMd"
              android:textStyle="bold"
              tools:text="#42" />
        </LinearLayout>
      </LinearLayout>

      <!-- Popularity card -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_users"
            android:tint="#FFD700" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="POPULARITY"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentScore"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/EmTitleMd"
              android:textStyle="bold"
              tools:text="#85" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- Row 1b: Favorites + Members (50/50) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

      <!-- Favorites card -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginEnd="4dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_heart"
            android:tint="#FFD700" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="FAVORITES"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentFavorites"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/EmTitleMd"
              android:textStyle="bold"
              tools:text="12,345" />
        </LinearLayout>
      </LinearLayout>

      <!-- Members card -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_eye"
            android:tint="#FFD700" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="MEMBERS"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentMembers"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/EmTitleMd"
              android:textStyle="bold"
              tools:text="456,789" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- Hidden score label (code compat) -->
    <LinearLayout
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentScoreHiddenLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Row 2: Studios + Premiered (50/50) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginBottom="12dp">

      <!-- Studios card -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginEnd="4dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_circles"
            android:tint="#FFD700" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="STUDIOS"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentType"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/FontSizeNormal"
              android:textStyle="bold"
              tools:text="Doga Kobo" />
        </LinearLayout>
      </LinearLayout>

      <!-- Premiered card -->
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="4dp"
          android:background="@drawable/electric_midnight_glass_panel"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="12dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/icon_calendar"
            android:tint="#FFD700" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:fontFamily="@font/inter"
              android:text="PREMIERED"
              android:textAllCaps="true"
              android:letterSpacing="0.08"
              android:textColor="?BrushTextSecondary"
              android:textSize="@dimen/EmLabelCaps" />

          <TextView
              android:id="@+id/AnimeDetailsPageGeneralTabFragmentPremiered"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:fontFamily="@font/inter"
              android:textColor="?BrushText"
              android:textSize="@dimen/FontSizeNormal"
              android:textStyle="bold"
              tools:text="Spring 2014" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <!-- Hidden fields (kept for code compat) -->
    <TextView
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentEpisodes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyStartButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <FrameLayout
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyEndButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
    <TextView
        android:id="@+id/AnimeDetailsPageGeneralTabFragmentMyEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Row 3: Synopsis with icon header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/electric_midnight_glass_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_marginBottom="8dp">

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/icon_list_bullets"
            android:tint="#FFD700" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="SYNOPSIS"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:textColor="?BrushTextSecondary"
            android:textSize="@dimen/EmLabelCaps" />
      </LinearLayout>

      <TextView
          android:id="@+id/AnimeDetailsPageGeneralTabFragmentSynopsis"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:fontFamily="@font/inter"
          android:lineSpacingMultiplier="1.4"
          android:text=""
          android:textColor="?BrushText"
          android:textSize="@dimen/FontSizeNormal" />
    </LinearLayout>

  </LinearLayout>
</android.support.v4.widget.NestedScrollView>

