<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?BrushDeepBackground"
            android:orientation="vertical">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content" android:padding="16dp"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:textSize="@dimen/FontSizeHuge" android:text="Welcome!"
      android:layout_height="wrap_content" android:textColor="?AccentColour" android:fontFamily="@string/font_family_light" />

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="Hi! Thanks for checking out this app ^^ I hope you like it. MALClient has been around since March 2016. I'll use this opportunity to invite you to try it out :)" android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>


    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="So... with this being out of the way I'd also like to mention that this app is fully open source and the entirety of its code is hosted on GitHub." android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <Button android:id="@+id/AboutPageViewSourceButton"
            android:layout_width="wrap_content" style="@style/AccentButtonStyle"
            android:layout_height="wrap_content" android:text="View the source!" android:layout_gravity="center_horizontal" android:layout_margin="10dp"/>

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="GitHub is also the best place to report bugs and feature requests." android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <Button android:id="@+id/AboutPageIssuesBoard"
            android:layout_width="wrap_content" style="@style/AccentButtonStyle"
            android:layout_height="wrap_content" android:text="To the issues board!" android:layout_gravity="center_horizontal" android:layout_margin="10dp"/>

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="There are also forum topics on MAL, feel free to drop in." android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:fontFamily="@string/font_family_light"
      android:text="Changelog" android:layout_marginTop="20dp"
      android:textColor="?AccentColour"
      android:textSize="@dimen/FontSizeHuge" />

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="Finally if you'd like to see what's new in latest update you can use the button below." android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <Button android:id="@+id/AboutPageChangelogButton"
            android:layout_width="wrap_content" style="@style/AccentButtonStyle"
            android:layout_height="wrap_content" android:text="Give me the news!" android:layout_gravity="center_horizontal" android:layout_margin="10dp"/>

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="If you'd like to check whether a newer version of the app is available, use the button below." android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <Button android:id="@+id/AboutPageCheckUpdatesButton"
            android:layout_width="wrap_content" style="@style/AccentButtonStyle"
            android:layout_height="wrap_content" android:text="Check for updates" android:layout_gravity="center_horizontal" android:layout_margin="10dp"/>


    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:fontFamily="@string/font_family_light"
      android:text="Credits" android:layout_marginTop="10dp"
      android:textColor="?AccentColour"
      android:textSize="@dimen/FontSizeHuge" />


    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="Coding, design(surprise! there's design... maybe... :D), and everything else: " android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:text="\@Drutol" android:layout_marginTop="10dp"
      android:textColor="?AccentColourDark"
      android:textSize="@dimen/FontSizeHuge" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:text="Piotr Szymczak"
      android:textColor="?AccentColourDark"
      android:textSize="@dimen/FontSizeBig" />

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="Currently maintained by" android:layout_marginTop="15dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:text="\@idarkalex" android:layout_marginTop="10dp"
      android:textColor="?AccentColourDark"
      android:textSize="@dimen/FontSizeHuge" />

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="Also huge thanks to these two brave testers who made this app actually usable ^^ Applauze!" android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>


    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:text="\@Kimod" android:layout_marginTop="10dp"
      android:textColor="?AccentColourDark"
      android:textSize="@dimen/FontSizeHuge" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:text="\@FoxInFlame" android:layout_marginTop="10dp"
      android:textColor="?AccentColourDark"
      android:textSize="@dimen/FontSizeHuge" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:fontFamily="@string/font_family_light"
      android:text="Tech note" android:layout_marginTop="20dp"
      android:textColor="?AccentColour"
      android:textSize="@dimen/FontSizeHuge" />

    <TextView android:lineSpacingExtra="2dp"
              android:layout_width="wrap_content" android:text="This app was written using C# and Xamarin for Android. It's a viable alternative to java... what isn't... かな..." android:layout_marginTop="10dp"
              android:layout_height="wrap_content" android:textColor="?BrushText"/>

    <FFImageLoading.Views.ImageViewAsync android:elevation="4dp"
                                         android:layout_width="wrap_content" android:maxHeight="200dp" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp"
                                         android:layout_height="wrap_content" android:adjustViewBounds="true" android:src="@drawable/annak" />


  </LinearLayout>



</ScrollView>