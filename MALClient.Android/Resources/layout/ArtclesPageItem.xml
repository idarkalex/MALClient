<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:clickable="true"
             android:focusable="true"
             android:foreground="?android:selectableItemBackground"
             android:paddingStart="8dp"
             android:paddingEnd="8dp"
             android:paddingTop="3dp"
             android:paddingBottom="3dp">
  <RelativeLayout android:background="@drawable/electric_midnight_glass_panel" android:paddingTop="10dp" android:paddingStart="10dp"
                  android:paddingBottom="10dp" android:paddingEnd="10dp" android:layout_width="match_parent"
                  android:layout_height="match_parent">
    <LinearLayout android:id="@+id/ArticlesPageItemInfoSection" android:layout_width="130dp"
                  android:layout_height="wrap_content" android:orientation="vertical">
      <FFImageLoading.Views.ImageViewAsync android:id="@+id/ArticlesPageItemImage" android:layout_width="130dp"
                                           android:layout_height="87dp" android:scaleType="centerCrop" />
      <TextView android:id="@+id/ArticlesPageItemAuthor" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="by Someguy83"
                android:fontFamily="@font/inter" android:textColor="?BrushTextSecondary"
                android:textSize="@dimen/FontSizeSemiNormal"
                android:layout_marginTop="6dp" />
      <TextView android:id="@+id/ArticlesPageItemViews" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="5,123 views" android:textColor="?BrushTextSecondary"
                android:fontFamily="@font/inter"
                android:textSize="@dimen/FontSizeSemiNormal"
                android:layout_marginTop="2dp" />
      <TextView android:id="@+id/ArticlesPageItemTags" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Quotes, Cold hearted, Love, Plot Twist"
                android:textColor="?AccentColour" android:fontFamily="@font/inter"
                android:textSize="@dimen/FontSizeSemiNormal" android:maxLines="2"
                android:ellipsize="end" android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_toEndOf="@+id/ArticlesPageItemInfoSection" android:paddingStart="12dp"
                  android:layout_width="match_parent" android:orientation="vertical"
                  android:layout_height="wrap_content">
      <TextView android:id="@+id/ArticlesPageItemHeader" android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What does &quot;Sugoi&quot; Mean? Really What could it mean it's an old mystery of the new gods..."
                android:maxLines="2" android:ellipsize="end" android:textSize="@dimen/FontSizeBig"
                android:fontFamily="@font/inter" android:textStyle="bold" android:textColor="?BrushText" />
      <View android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:background="#1affffff"
            android:layout_marginTop="6dp" android:layout_width="match_parent" android:layout_height="1dp" />
      <TextView android:id="@+id/ArticlesPageItemHighlight" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:fontFamily="@font/inter" android:maxLines="9" android:ellipsize="end"
                android:textSize="@dimen/FontSizeNormal"
                android:textColor="?BrushText" />
    </LinearLayout>
  </RelativeLayout>
</FrameLayout>
