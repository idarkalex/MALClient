<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MALPlus.Views"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.CalendarPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Day strip. A fixed row of equal cells with hairline separators, NOT a ScrollView:
             seven days plus the summary fit the width without scrolling, and the scroller was
             swallowing the taps. -->
        <Grid Grid.Row="0" x:Name="TabStrip" ColumnSpacing="0" Margin="6,8,6,4" />

        <!-- Source filter: the whole season vs only what is on my list. Same shape as v2's
             segmented bar: accent text plus a 3dp underline on the active side. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="16,0,16,4">
            <VerticalStackLayout Grid.Column="0" Spacing="4" x:Name="SeasonSection">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSeasonModeTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="Current Season" x:Name="SeasonFilterLabel" FontFamily="InterSemiBold"
                       FontSize="14" HorizontalOptions="Center" />
                <BoxView HeightRequest="3" BackgroundColor="Transparent" x:Name="SeasonFilterIndicator" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="4" x:Name="MyListSection">
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMyListModeTapped" />
                </VerticalStackLayout.GestureRecognizers>
                <Label Text="My List" x:Name="MyListFilterLabel" FontFamily="InterSemiBold"
                       FontSize="14" HorizontalOptions="Center" />
                <BoxView HeightRequest="3" BackgroundColor="Transparent" x:Name="MyListFilterIndicator" />
            </VerticalStackLayout>
        </Grid>

        <!-- Loading overlay -->
        <Grid Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding CalendarBuildingVisibility}"
              BackgroundColor="#80000000" VerticalOptions="Fill" HorizontalOptions="Fill">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="36" HeightRequest="36" />
                <Label Text="Building calendar..." FontFamily="Inter" FontSize="13"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Calendar Content (pivot) -->
        <Grid Grid.Row="3" IsVisible="{Binding CalendarVisibility}">
            <!-- The shared project cannot reach logcat and a silent catch left a stale calendar on
                 screen looking like a mode switch that did nothing, so the failure is shown. -->
            <Label Text="{Binding BuildError}" IsVisible="{Binding BuildError, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                   FontFamily="Inter" FontSize="12" TextColor="#FF6B6B"
                   Padding="16,4" LineBreakMode="CharacterWrap" />

            <CarouselView x:Name="CalendarCarousel"
                          ItemsSource="{Binding CalendarData}"
                          Position="{Binding CalendarPivotIndex, Mode=TwoWay}"
                          Loop="False">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowDefinitions="Auto,*" Padding="16" RowSpacing="12">
                            <!-- Day Header -->
                            <HorizontalStackLayout Grid.Row="0" Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding Header}" FontFamily="InterBold" FontSize="20"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                <Label Text="{Binding Sub}" FontFamily="Inter" FontSize="14"
                                       TextColor="#80FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Items: the same poster grid as the rest of the app. The per-row
                                 buttons of the old list layout have no place on a poster. -->
                            <Grid Grid.Row="1">
                                <controls:AnimePosterGrid x:Name="DayGrid"
                                    ItemsSource="{Binding Items}">
                                    <controls:AnimePosterGrid.CellTemplate>
                                        <DataTemplate>
                                            <Grid BackgroundColor="Transparent">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnPosterTapped"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <controls:AnimePosterCard
                                                    HeightRequest="{Binding Source={x:Reference DayGrid}, Path=CellHeight}"
                                                    PosterUrl="{Binding ImgUrl}"
                                                    Title="{Binding Title}"
                                                    TitleOverlay="True"
                                                    TypeTag="{Binding TypeTag}"
                                                    BadgeVisible="True"
                                                    BadgeAccent="{Binding LibraryBadgeAccent}"
                                                    BadgeMain="{Binding LibraryBadgeMain}"
                                                    BadgeExtra="{Binding AirDayTillBind}" />
                                            </Grid>
                                        </DataTemplate>
                                    </controls:AnimePosterGrid.CellTemplate>
                                </controls:AnimePosterGrid>

                                <Label Text="Nothing airing today" FontFamily="Inter" FontSize="14"
                                       TextColor="#80FFFFFF" HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding Source={x:Reference DayGrid}, Path=IsEmpty}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
        </Grid>
    </Grid>
</ContentPage>
