<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.Views.LogInPage"
             BackgroundColor="{StaticResource EmBackground}">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" VerticalOptions="Center">
            <Label x:Name="DebugLabel" FontFamily="Inter" FontSize="10" TextColor="Yellow" />
            <Label Text="Log In" FontFamily="InterBold" FontSize="24"
                   TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            <Entry x:Name="UserEntry" Placeholder="MAL username" Text="{Binding UserNameInput}"
                   FontFamily="Inter" FontSize="14" />
            <Entry Placeholder="Password" Text="{Binding PasswordInput}" IsPassword="True"
                   FontFamily="Inter" FontSize="14" />
            <Button Text="Log In" Command="{Binding LogInCommand}"
                    FontFamily="InterSemiBold" FontSize="14" />
            <ActivityIndicator IsRunning="{Binding Authenticating}" IsVisible="{Binding Authenticating}"
                               Color="{StaticResource EmAccent}" HorizontalOptions="Center" />
            <Button Text="Log Out" Command="{Binding LogOutCommand}"
                    IsVisible="{Binding LogOutButtonVisibility}"
                    FontFamily="InterSemiBold" FontSize="14" />
            <Button Text="Register on myanimelist.net" Command="{Binding NavigateRegister}"
                    FontFamily="Inter" FontSize="12" BackgroundColor="Transparent"
                    TextColor="{StaticResource EmAccent}" />
            <Button Text="Sign in with MyAnimeList (web)" Clicked="OnWebSignInClicked"
                    FontFamily="InterSemiBold" FontSize="14" />
        </VerticalStackLayout>
    </ScrollView>
    <Grid x:Name="WebOverlay" IsVisible="False" BackgroundColor="#051522"
          VerticalOptions="Fill" HorizontalOptions="Fill">
        <Grid RowDefinitions="Auto,*">
            <Button Text="Close" Clicked="OnWebCloseClicked"
                    FontFamily="InterSemiBold" FontSize="14"
                    HorizontalOptions="End" Margin="0,8,8,0" />
            <WebView x:Name="AuthWebView" Grid.Row="1" Navigating="OnAuthNavigating" />
        </Grid>
    </Grid>
    </Grid>
</ContentPage>
