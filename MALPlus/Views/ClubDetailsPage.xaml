<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.ClubDetailsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:HtmlSourceConverter x:Key="HtmlSource" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <ScrollView IsVisible="{Binding Loading, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <VerticalStackLayout Padding="16,12,16,32" Spacing="14">
                <Grid ColumnDefinitions="80,*" ColumnSpacing="14">
                    <Border Grid.Column="0" WidthRequest="72" HeightRequest="72"
                            StrokeShape="RoundRectangle 12"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding Details.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Label Text="{Binding Details.Name}" FontFamily="InterBold" FontSize="18"
                               TextColor="{StaticResource BrushText}" MaxLines="3"
                               LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Details.MembersPeek.Count, StringFormat='{0} members'}"
                               FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                    </VerticalStackLayout>
                </Grid>

                <Border BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <WebView Source="{Binding Details.DescriptionHtml, Converter={StaticResource HtmlSource}}"
                             HeightRequest="240" />
                </Border>

                <Border BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        IsVisible="{Binding Details.MembersPeek.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="MEMBERS" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView ItemsSource="{Binding Details.MembersPeek}" HeightRequest="200"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="32,*" ColumnSpacing="8" Padding="0,4">
                                        <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                               Aspect="AspectFill" WidthRequest="28" HeightRequest="28" />
                                        <Label Grid.Column="1" Text="{Binding Name}" FontFamily="Inter" FontSize="13"
                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        IsVisible="{Binding Details.RecentComments.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="COMMENTS" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView ItemsSource="{Binding Details.RecentComments}" HeightRequest="200"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="10">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding User.Name}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" />
                                            <Label Text="{Binding Content}" FontFamily="Inter" FontSize="12"
                                                   TextColor="#C0FFFFFF" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
