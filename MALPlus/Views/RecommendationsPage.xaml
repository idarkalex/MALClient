<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.RecommendationsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,Auto,*">
            <Label Grid.Row="0" Text="Recommendations" FontFamily="InterBold" FontSize="22"
                   TextColor="{StaticResource BrushText}" Padding="16,12" />

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="12,0,12,8">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="AnimeTab" Text="Anime" Clicked="OnModeClicked"
                            CommandParameter="Anime" FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#0066FF" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                            Padding="12,6" HeightRequest="32" />
                    <Button x:Name="MangaTab" Text="Manga" Clicked="OnModeClicked"
                            CommandParameter="Manga" FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="Transparent" TextColor="{StaticResource BrushText}"
                            BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="16"
                            Padding="12,6" HeightRequest="32" />
                </HorizontalStackLayout>
            </ScrollView>

            <RefreshView Grid.Row="2" IsRefreshing="{Binding Loading}" Refreshing="OnRefreshing">
                <CollectionView x:Name="ItemsList" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No recommendations" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,6" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="{Binding Header}"
                                           FontFamily="Inter" FontSize="13" TextColor="{StaticResource BrushText}"
                                           MaxLines="3" LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Open" Clicked="OnOpenClicked"
                                            CommandParameter="{Binding .}"
                                            FontFamily="InterSemiBold" FontSize="12"
                                            BackgroundColor="#0066FF" TextColor="White"
                                            CornerRadius="8" HeightRequest="32" Padding="10,0"
                                            VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
