<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.ProfilePage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:HtmlSourceConverter x:Key="HtmlSource" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingVisibility}" BackgroundColor="#80000000"
              VerticalOptions="Fill" HorizontalOptions="Fill" ZIndex="99">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="36" HeightRequest="36" />
                <Label Text="Loading profile..." FontFamily="Inter" FontSize="13"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView IsVisible="{Binding LoadingVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <VerticalStackLayout Spacing="14" Padding="16,12,16,32">

                <!-- Pull-to-refresh wrapper -->
                <RefreshView IsRefreshing="{Binding LoadingVisibility}" Refreshing="OnRefreshing">
                    <Label Text="↓ pull to refresh" FontFamily="Inter" FontSize="11"
                           TextColor="#40FFFFFF" HorizontalOptions="Center" Padding="0,0,0,4" />
                </RefreshView>

                <!-- Header: avatar + name + stats summary -->
                <Border BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 12" Padding="16">
                    <Grid ColumnDefinitions="80,*,Auto" ColumnSpacing="14">
                        <Border Grid.Column="0" WidthRequest="72" HeightRequest="72"
                                StrokeShape="RoundRectangle 36"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                            <Image Source="{Binding CurrentData.User.ImgUrl, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding CurrentData.User.Name}" FontFamily="InterBold" FontSize="20"
                                   TextColor="{StaticResource BrushText}" />
                            <HorizontalStackLayout Spacing="12">
                                <Label Text="{Binding CurrentData.AnimeCompleted, StringFormat='{0} anime'}"
                                       FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                                <Label Text="{Binding CurrentData.MangaCompleted, StringFormat='{0} manga'}"
                                       FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                            <Button Text="↻" Clicked="OnRefreshClicked" WidthRequest="36" HeightRequest="36"
                                    FontFamily="InterBold" FontSize="16"
                                    BackgroundColor="#141d2b" TextColor="White"
                                    BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="8" Padding="0" />
                            <Button Text="⇄" Clicked="OnCompareClicked" WidthRequest="36" HeightRequest="36"
                                    FontFamily="InterBold" FontSize="16"
                                    BackgroundColor="#141d2b" TextColor="{StaticResource EmAccent}"
                                    BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="8" Padding="0" />
                            <Button Text="↩" Clicked="OnHistoryClicked" WidthRequest="36" HeightRequest="36"
                                    FontFamily="InterBold" FontSize="16"
                                    BackgroundColor="#141d2b" TextColor="White"
                                    BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="8" Padding="0" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- About Me -->
                <Border BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14"
                        IsVisible="{Binding AboutMeWebViewVisibility}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ABOUT ME" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <WebView Source="{Binding AboutMeHtmlContent, Converter={StaticResource HtmlSource}}"
                                 HeightRequest="200" />
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites - Anime -->
                <Border IsVisible="{Binding FavAnime.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="FAVOURITE ANIME" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="FavAnimeList" ItemsSource="{Binding FavAnime}" HeightRequest="200"
                                        SelectionMode="Single" SelectionChanged="OnFavAnimeTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites - Manga -->
                <Border IsVisible="{Binding FavManga.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="FAVOURITE MANGA" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="FavMangaList" ItemsSource="{Binding FavManga}" HeightRequest="200"
                                        SelectionMode="Single" SelectionChanged="OnFavMangaTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites - Characters -->
                <Border IsVisible="{Binding FavouriteCharacters.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="FAVOURITE CHARACTERS" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="FavCharactersList" ItemsSource="{Binding FavouriteCharacters}" HeightRequest="180"
                                        SelectionMode="Single" SelectionChanged="OnFavCharacterTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Favorites - Staff -->
                <Border IsVisible="{Binding FavouriteStaff.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="FAVOURITE STAFF" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="FavStaffList" ItemsSource="{Binding FavouriteStaff}" HeightRequest="180"
                                        SelectionMode="Single" SelectionChanged="OnFavStaffTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Anime -->
                <Border IsVisible="{Binding RecentAnime.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="RECENT ANIME" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="RecentAnimeList" ItemsSource="{Binding RecentAnime}" HeightRequest="160"
                                        SelectionMode="Single" SelectionChanged="OnRecentAnimeTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Recent Manga -->
                <Border IsVisible="{Binding RecentManga.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="RECENT MANGA" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="RecentMangaList" ItemsSource="{Binding RecentManga}" HeightRequest="160"
                                        SelectionMode="Single" SelectionChanged="OnRecentMangaTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Friends -->
                <Border IsVisible="{Binding MyFriends.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="FRIENDS" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView x:Name="FriendsList" ItemsSource="{Binding MyFriends}" HeightRequest="160"
                                        SelectionMode="Single" SelectionChanged="OnFriendTapped">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10,6">
                                        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding ImageUrl, Converter={StaticResource ImageConverter}}"
                                                   WidthRequest="36" HeightRequest="36" Aspect="AspectFill" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontFamily="InterBold" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="1" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Comments -->
                <Border IsVisible="{Binding MalComments.Count, Converter={StaticResource BoolVis}, ConverterParameter=hasitems}"
                        BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="COMMENTS" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <CollectionView ItemsSource="{Binding MalComments}" HeightRequest="200"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="{StaticResource EmBackground}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Margin="0,0,0,6" Padding="10">
                                        <VerticalStackLayout Spacing="4">
                                            <HorizontalStackLayout Spacing="8">
                                                <Image Source="{Binding User.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                       WidthRequest="28" HeightRequest="28" Aspect="AspectFill" />
                                                <Label Text="{Binding User.Name}" FontFamily="InterBold" FontSize="13"
                                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                                <Label Text="{Binding Date}" FontFamily="Inter" FontSize="11"
                                                       TextColor="#80FFFFFF" VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Content}" FontFamily="Inter" FontSize="13"
                                                   TextColor="{StaticResource BrushText}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Stats summary -->
                <Border BackgroundColor="{StaticResource EmSheet}"
                        Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="STATS" FontFamily="InterBold" FontSize="10"
                               TextColor="#A0FFFFFF" />
                        <Label Text="{Binding ApproxTimeSpentOnAnime}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource EmAccent}" />
                        <Label Text="{Binding ApproxTimeSpentOnAnimeAndMovies}" FontFamily="Inter" FontSize="12"
                               TextColor="#80FFFFFF" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
