<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Name="StaffDetailsPageRoot"
             x:Class="MALPlus.Views.StaffDetailsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="StaffTabLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#B3FFFFFF" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Padding" Value="0,7" />
        </Style>

        <DataTemplate x:Key="StaffInfoRowTemplate">
            <Border Margin="0,0,0,7" Padding="11,9" BackgroundColor="#0AFFFFFF" StrokeShape="RoundRectangle 6">
                <Label Text="{Binding .}" FontFamily="Inter" FontSize="13"
                       TextColor="{StaticResource BrushText}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StaffVoiceRoleTemplate">
            <Border Margin="0,0,0,10" Padding="0" BackgroundColor="#0AFFFFFF"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <Grid ColumnDefinitions="*,1,*">
                    <Grid Grid.Column="0" ColumnDefinitions="56,*" ColumnSpacing="9" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoiceRoleShowTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="56" HeightRequest="80" StrokeShape="RoundRectangle 6"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                            <Image Source="{Binding AnimeLightEntry.ImgUrl, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="SHOW" FontFamily="InterBold" FontSize="9" TextColor="#80B4FF" />
                            <Label Text="{Binding AnimeLightEntry.Title}" FontFamily="InterBold" FontSize="12"
                                   TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <controls:SpoilerTextView Text="{Binding AnimeLightEntry.Notes}"
                                                       TextColor="#A0FFFFFF" TextSize="10" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Grid.Column="1" WidthRequest="1" Color="{StaticResource EmBorder}" />

                    <Grid Grid.Column="2" ColumnDefinitions="56,*" ColumnSpacing="9" Padding="10">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoiceRoleCharacterTapped" CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border WidthRequest="56" HeightRequest="80" StrokeShape="RoundRectangle 6"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                            <Image Source="{Binding AnimeCharacter.ImgUrl, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="CHARACTER" FontFamily="InterBold" FontSize="9" TextColor="#FFFFA45C" />
                            <Label Text="{Binding AnimeCharacter.Name}" FontFamily="InterBold" FontSize="12"
                                   TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                            <controls:SpoilerTextView Text="{Binding AnimeCharacter.Notes}"
                                                       TextColor="#A0FFFFFF" TextSize="10" />
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StaffProductionRoleTemplate">
            <Border Margin="0,0,0,10" Padding="10" BackgroundColor="#0AFFFFFF"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStaffPositionTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="100,*" ColumnSpacing="12">
                    <Border WidthRequest="100" HeightRequest="140" StrokeShape="RoundRectangle 6"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource BrushText}" MaxLines="3" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="6">
                            <Border Padding="7,3" BackgroundColor="#1A0066FF" StrokeShape="RoundRectangle 6"
                                    IsVisible="{Binding IsAnime}">
                                <Label Text="ANIME" FontFamily="InterSemiBold" FontSize="9" TextColor="#80B4FF" />
                            </Border>
                            <Border Padding="7,3" BackgroundColor="#1AFF6B00" StrokeShape="RoundRectangle 6"
                                    IsVisible="{Binding IsAnime, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <Label Text="MANGA" FontFamily="InterSemiBold" FontSize="9" TextColor="#FFFFA45C" />
                            </Border>
                        </HorizontalStackLayout>
                        <Label Text="ROLE / MEDIA TYPE" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF" />
                        <controls:SpoilerTextView Text="{Binding Notes}" TextColor="#C0FFFFFF" TextSize="12" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#CC000510" ZIndex="99">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading..." FontFamily="Inter" FontSize="12"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.RowSpan="3" RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding Loading, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Grid x:Name="FullHero" Grid.Row="0" HeightRequest="300" BackgroundColor="#000000">
                <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                       Aspect="AspectFill" />
                <BoxView>
                    <BoxView.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.0" />
                            <GradientStop Color="#18000000" Offset="0.45" />
                            <GradientStop Color="#F0051522" Offset="1.0" />
                        </LinearGradientBrush>
                    </BoxView.Background>
                </BoxView>
                <VerticalStackLayout VerticalOptions="End" Padding="20,0,20,18" Spacing="7">
                    <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="24"
                           TextColor="White" MaxLines="2" LineBreakMode="TailTruncation" />
                    <HorizontalStackLayout Spacing="7">
                        <Border Padding="8,4" BackgroundColor="#1A0066FF" StrokeShape="RoundRectangle 7">
                            <Label Text="STAFF / PERSON" FontFamily="InterSemiBold" FontSize="10" TextColor="#80B4FF" />
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <ScrollView Grid.Row="1" HorizontalOptions="Fill" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="14,0,14,0" BackgroundColor="{StaticResource EmBackground}">
                <HorizontalStackLayout Spacing="20">
                    <Label x:Name="InfoTabLabel" Text="Info" Style="{StaticResource StaffTabLabelStyle}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnInfoTabTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="VoiceRolesTabLabel" Text="Voice Acting Roles" Style="{StaticResource StaffTabLabelStyle}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVoiceRolesTabTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="ProductionRolesTabLabel" Text="Production Roles" Style="{StaticResource StaffTabLabelStyle}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnProductionRolesTabTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </ScrollView>

            <Grid Grid.Row="2" x:Name="TabContentHost" Padding="16,8,16,0">

                <ScrollView x:Name="InfoTab">
                    <Border BackgroundColor="{StaticResource EmSheet}" Stroke="{StaticResource EmBorder}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="INFO" FontFamily="InterBold" FontSize="11" TextColor="#C0FFFFFF" />
                            <VerticalStackLayout Spacing="7" BindableLayout.ItemsSource="{Binding Data.Details}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="11,9" BackgroundColor="#0AFFFFFF" StrokeShape="RoundRectangle 6">
                                            <controls:SpoilerTextView Text="{Binding .}"
                                                                       TextColor="{StaticResource BrushText}"
                                                                       TextSize="13" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </ScrollView>

                <Grid x:Name="VoiceRolesTab" IsVisible="False" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Margin="0,0,0,8" BackgroundColor="{StaticResource EmSheet}"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="VOICE ACTING ROLES" FontFamily="InterBold" FontSize="11" TextColor="#C0FFFFFF" />
                            <Label Grid.Column="1" Text="{Binding Data.ShowCharacterPairs.Count}" FontFamily="InterSemiBold"
                                   FontSize="11" TextColor="#80B4FF" />
                        </Grid>
                    </Border>
                    <CollectionView Grid.Row="1" x:Name="VoiceRolesList"
                                    ItemsSource="{Binding Data.ShowCharacterPairs}"
                                    ItemTemplate="{StaticResource StaffVoiceRoleTemplate}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </Grid>

                <Grid x:Name="ProductionRolesTab" IsVisible="False" RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Margin="0,0,0,8" BackgroundColor="{StaticResource EmSheet}"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                            Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="PRODUCTION ROLES" FontFamily="InterBold" FontSize="11" TextColor="#C0FFFFFF" />
                            <Label Grid.Column="1" Text="{Binding Data.StaffPositions.Count}" FontFamily="InterSemiBold"
                                   FontSize="11" TextColor="#FFFFA45C" />
                        </Grid>
                    </Border>
                    <CollectionView Grid.Row="1" x:Name="ProductionRolesList"
                                    ItemsSource="{Binding Data.StaffPositions}"
                                    ItemTemplate="{StaticResource StaffProductionRoleTemplate}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                        </CollectionView.ItemsLayout>
                    </CollectionView>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>