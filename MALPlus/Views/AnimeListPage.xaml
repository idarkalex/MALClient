<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.AnimeListPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <RefreshView x:Name="ListRefresh" Grid.Row="0" IsRefreshing="{Binding Loading, Mode=OneWay}" Refreshing="OnRefreshing">
            <CollectionView x:Name="AnimeGrid"
                            ItemsSource="{Binding AnimeItems}"
                            SelectionMode="Single"
                             SelectionChanged="OnSelectionChanged"
                             RemainingItemsThreshold="4"
                             RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid HeightRequest="195" Padding="2">
                            <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />

                            <Border BackgroundColor="#B3051522" Stroke="#4DFFFFFF" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="6,3" Margin="6,6,6,0"
                                    HorizontalOptions="End" VerticalOptions="Start">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding MyStatusBindShort}"
                                           FontFamily="InterBold" FontSize="9"
                                           TextColor="{StaticResource EmAccent}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding MyEpisodesBindShort}"
                                           FontFamily="InterBold" FontSize="9"
                                           TextColor="#FFFFFF"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding AirDayTillBind}"
                                           FontFamily="InterBold" FontSize="9"
                                           TextColor="#FFFFFF"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding AirDayTillBind, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                                </HorizontalStackLayout>
                            </Border>

                            <controls:OutlinedLabel Text="{Binding Title}" FontFamily="Inter" FontSize="11"
                                                   TextColor="White" OutlineColor="Black" OutlineWidth="2.5"
                                                   MaxLines="2" HeightRequest="32"
                                                   VerticalOptions="End" Margin="4,0,4,4"
                                                   InputTransparent="True" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Text="{Binding EmptyNoticeContent}" IsVisible="{Binding EmptyNoticeVisibility}"
               FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
               HorizontalOptions="Center" VerticalOptions="Center"
               Grid.Row="0" />

        <controls:BottomNavBar x:Name="BottomNav" Grid.Row="1" />
    </Grid>
</ContentPage>
