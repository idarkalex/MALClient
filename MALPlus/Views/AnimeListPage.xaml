<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.AnimeListPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Status tabs (All / Watching / Completed / On Hold / Dropped / Planned) -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                    Padding="12,8" Margin="0,4,0,0">
            <HorizontalStackLayout x:Name="StatusTabsStrip" Spacing="6" />
        </ScrollView>

        <RefreshView x:Name="ListRefresh" Grid.Row="1" IsRefreshing="{Binding Loading, Mode=OneWay}" Refreshing="OnRefreshing">
            <CollectionView x:Name="AnimeGrid"
                            ItemsSource="{Binding AnimeItems}"
                            SelectionMode="Single"
                             SelectionChanged="OnSelectionChanged"
                             RemainingItemsThreshold="4"
                             RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="3" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid HeightRequest="195" Padding="2">
                            <Image Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />

                            <Border BackgroundColor="#B3051522" Stroke="#4DFFFFFF" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="6,3" Margin="6,6,6,0"
                                    HorizontalOptions="End" VerticalOptions="Start">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Label Text="{Binding MyStatusBindShort}"
                                           FontFamily="InterBold" FontSize="9"
                                           TextColor="{StaticResource EmAccent}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding MyEpisodesBindShort}"
                                           FontFamily="InterBold" FontSize="9"
                                           TextColor="#FFFFFF"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding AirDayTillBind}"
                                           FontFamily="InterBold" FontSize="9"
                                           TextColor="#FFFFFF"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding AirDayTillBind, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                                </HorizontalStackLayout>
                            </Border>

                            <Border BackgroundColor="#590066FF" Stroke="#4DFFFFFF" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8,2" Margin="6,0,6,32"
                                    HorizontalOptions="Start" VerticalOptions="End"
                                    IsVisible="{Binding TimeTillNextAirCache, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}">
                                <Label Text="{Binding TimeTillNextAirCache}"
                                       FontFamily="Inter" FontSize="9" TextColor="#FFFFFF" />
                            </Border>

                            <Label Text="{Binding Title}" FontFamily="Inter" FontSize="11"
                                   TextColor="White" MaxLines="2" LineBreakMode="TailTruncation"
                                   VerticalOptions="End" Margin="4,0,4,4" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Label Text="{Binding EmptyNoticeContent}" IsVisible="{Binding EmptyNoticeVisibility}"
               FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
               HorizontalOptions="Center" VerticalOptions="Center"
               Grid.Row="1" />

        <controls:BottomNavBar Grid.Row="2" />
    </Grid>
</ContentPage>
