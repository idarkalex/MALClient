<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.AnimeDetailsPage"
             x:Name="DetailsPage"
             Shell.PresentationMode="NotAnimated"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:AiringStatusVisibilityConverter x:Key="AiringStatus" />
        <converters:MultiAndConverter x:Key="MultiAnd" />

        <Style x:Key="TabLabelStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="InterSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="#B3FFFFFF" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Padding" Value="0,7" />
        </Style>

        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource EmSheet}" />
            <Setter Property="Stroke" Value="{StaticResource EmBorder}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
        </Style>

        <Style x:Key="StateTextStyle" TargetType="Label">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource BrushText}" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <DataTemplate x:Key="EpisodeTemplate">
            <Border Margin="12,4" Style="{StaticResource PanelStyle}" Padding="14,11">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEpisodeTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label Text="{Binding EpisodeId, StringFormat='Ep {0}'}"
                           FontFamily="InterBold" FontSize="14" TextColor="#0066FF"
                           VerticalOptions="Center" MinimumWidthRequest="52" MaxLines="1" />
                    <Label Grid.Column="1" Text="{Binding Title}" FontFamily="Inter" FontSize="14"
                           TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ReviewTemplate">
            <Border Margin="12,4" Style="{StaticResource PanelStyle}" Padding="14,11">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                            <Image Source="{Binding AuthorAvatar, Converter={StaticResource ImageConverter}}"
                                   Aspect="AspectFill" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding Author}" FontFamily="InterBold" FontSize="13"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" MaxLines="1"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="2" Text="{Binding OverallRating}" FontFamily="InterBold" FontSize="14"
                               TextColor="#FFD700" VerticalOptions="Center" MaxLines="1" />
                    </Grid>
                    <Label Text="{Binding Review}" FontFamily="Inter" FontSize="12" TextColor="#C0FFFFFF"
                           MaxLines="{Binding ReviewMaxLines}" LineBreakMode="TailTruncation" />
                    <Button Text="{Binding ReviewToggleText}" Clicked="OnReviewMoreClicked"
                            CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderWidth="0"
                            Padding="0" HeightRequest="28" HorizontalOptions="Start"
                            FontFamily="InterSemiBold" FontSize="11" TextColor="#0066FF" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecommendationTemplate">
            <Border Margin="12,6" Style="{StaticResource PanelStyle}" Padding="12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecommendationTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid RowSpacing="10" RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="130,*" ColumnSpacing="14">
                        <controls:AnimePosterCard Grid.Column="0" WidthRequest="130" HeightRequest="195"
                                                   PosterUrl="{Binding ImageUrl}"
                                                   TitleOverlay="False"
                                                   TypeTag="{Binding MediaType}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Start">
                            <Label Text="{Binding Title}" FontFamily="InterBold" FontSize="16"
                                   TextColor="{StaticResource BrushText}" MaxLines="3" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Type}" FontFamily="InterSemiBold" FontSize="11"
                                       TextColor="#7AB4FF" MaxLines="1" />
                                <Label Text="{Binding AirDayTillBind}" FontFamily="InterSemiBold" FontSize="11"
                                       TextColor="White" MaxLines="1"
                                       IsVisible="{Binding AirDayTillBind, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <Label Grid.Row="1" Text="{Binding Description}" FontFamily="Inter" FontSize="13"
                           TextColor="#B8C7D8" LineHeight="1.35"
                           IsVisible="{Binding Description, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RelationChipTemplate">
            <Border Margin="0" Padding="6,2" StrokeShape="RoundRectangle 6"
                    BackgroundColor="#0066FF" Stroke="Transparent">
                <Label Text="{Binding .}" FontFamily="InterBold" FontSize="9" TextColor="White" MaxLines="1" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RelatedTemplate">
            <Border WidthRequest="130" HeightRequest="231" StrokeShape="RoundRectangle 8"
                    BackgroundColor="{StaticResource EmSheet}" Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRecommendationTapped" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="195,36">
                    <controls:AnimePosterCard Grid.Row="0"
                                               PosterUrl="{Binding ImgUrl}"
                                               TitleOverlay="False"
                                               TypeTag="{Binding MediaType}"
                                               ChipSource="{Binding Relations}"
                                               ChipTemplate="{StaticResource RelationChipTemplate}" />
                    <controls:OutlinedLabel Grid.Row="1" Text="{Binding Title}" FontFamily="Inter" FontSize="10"
                                           TextColor="White" OutlineColor="Black" OutlineWidth="2.5"
                                           MaxLines="2" HeightRequest="36" InputTransparent="True"
                                           VerticalOptions="Center" Margin="4,0,4,3" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="VoiceActorTemplate">
            <Border Margin="0,4,0,0" Padding="8" StrokeShape="RoundRectangle 8"
                    BackgroundColor="#0F1A29" Stroke="#29FFFFFF" StrokeThickness="1">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStaffTapped" CommandParameter="{Binding Data.Id}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                    <Border WidthRequest="48" HeightRequest="64" StrokeShape="RoundRectangle 6"
                            Stroke="#29FFFFFF" StrokeThickness="1">
                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="12"
                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Data.Notes}" FontFamily="Inter" FontSize="10"
                               TextColor="#7AB4FF" MaxLines="1" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AnimeCharacterTemplate">
            <Border Margin="12,5" Style="{StaticResource PanelStyle}" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Border Padding="8" StrokeShape="RoundRectangle 8" BackgroundColor="#0F1A29"
                            Stroke="#29FFFFFF" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCharacterTapped"
                                                  CommandParameter="{Binding AnimeCharacter.Data.Id}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                            <Border WidthRequest="64" HeightRequest="88" StrokeShape="RoundRectangle 6"
                                    Stroke="#29FFFFFF" StrokeThickness="1">
                                <Image Source="{Binding AnimeCharacter.Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                       Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding AnimeCharacter.Data.Name}" FontFamily="InterBold" FontSize="14"
                                       TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding AnimeCharacter.Data.Notes}" FontFamily="Inter" FontSize="11"
                                       TextColor="#8FA8C0" MaxLines="2" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <Border IsVisible="{Binding UseLegacyStaffBinding}" Padding="8"
                            StrokeShape="RoundRectangle 8" BackgroundColor="#0F1A29"
                            Stroke="#29FFFFFF" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStaffTapped"
                                                  CommandParameter="{Binding AnimeStaffPerson.Data.Id}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="48,*" ColumnSpacing="10">
                            <Border WidthRequest="48" HeightRequest="64" StrokeShape="RoundRectangle 6"
                                    Stroke="#29FFFFFF" StrokeThickness="1">
                                <Image Source="{Binding AnimeStaffPerson.Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                                       Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding AnimeStaffPerson.Data.Name}" FontFamily="InterBold" FontSize="12"
                                       TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Text="Voice" FontFamily="Inter" FontSize="10" TextColor="#7AB4FF" MaxLines="1" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding HasVoiceActors}" Spacing="2">
                        <Label Text="VOICE ACTORS" FontFamily="InterBold" FontSize="9" TextColor="#8FA8C0"
                               MaxLines="1" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding VoiceActors}"
                                             BindableLayout.ItemTemplate="{StaticResource VoiceActorTemplate}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MangaCharacterTemplate">
            <Border Margin="12,5" Style="{StaticResource PanelStyle}" Padding="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCharacterTapped" CommandParameter="{Binding Data.Id}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                    <Border WidthRequest="64" HeightRequest="88" StrokeShape="RoundRectangle 6"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Data.Notes}" FontFamily="Inter" FontSize="11" TextColor="#8FA8C0"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="StaffTemplate">
            <Border Margin="12,5" Style="{StaticResource PanelStyle}" Padding="10">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStaffTapped" CommandParameter="{Binding Data.Id}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="64,*" ColumnSpacing="10">
                    <Border WidthRequest="64" HeightRequest="88" StrokeShape="RoundRectangle 6"
                            Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                        <Image Source="{Binding Data.ImgUrl, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding Data.Name}" FontFamily="InterBold" FontSize="14"
                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding Data.Notes}" FontFamily="Inter" FontSize="11" TextColor="#8FA8C0"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid BackgroundColor="{StaticResource EmSheet}">
        <ScrollView x:Name="PageScroll" Scrolled="OnPageScrolled"
                        SizeChanged="OnPageViewportSizeChanged"
                        VerticalScrollBarVisibility="Never" HorizontalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">
                <Grid x:Name="HeaderSpacer" HeightRequest="600" BackgroundColor="Transparent" />

                <Grid x:Name="TabContentHost" BackgroundColor="{StaticResource EmSheet}">
                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                                         Padding="12,12,12,32" Spacing="12">
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralLoadingVisible}"
                                Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingGlobal}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading details..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralErrorVisible}"
                                Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=GeneralErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralContentVisible}"
                                             Spacing="12">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border Style="{StaticResource PanelStyle}" Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="RANK" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                        <Label Text="{Binding GeneralRank}" FontFamily="InterBold" FontSize="18"
                                               TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="POPULARITY" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                        <Label Text="{Binding GeneralPopularity}" FontFamily="InterBold" FontSize="18"
                                               TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border Style="{StaticResource PanelStyle}" Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="FAVORITES" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                        <Label Text="{Binding GeneralFavorites}" FontFamily="InterBold" FontSize="18"
                                               TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="MEMBERS" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                        <Label Text="{Binding GeneralMembers}" FontFamily="InterBold" FontSize="18"
                                               TextColor="{StaticResource BrushText}" MaxLines="1" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border Style="{StaticResource PanelStyle}" Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="STUDIOS" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                        <Label Text="{Binding GeneralStudios}" FontFamily="InterBold" FontSize="15"
                                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Padding="12">
                                    <VerticalStackLayout Spacing="3">
                                        <Label Text="PREMIERED" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                        <Label Text="{Binding GeneralSeason}" FontFamily="InterBold" FontSize="15"
                                               TextColor="{StaticResource BrushText}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Border Style="{StaticResource PanelStyle}" Padding="14">
                                <VerticalStackLayout Spacing="7">
                                    <Label Text="SYNOPSIS" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                    <Label Text="{Binding Synopsis}" FontFamily="Inter" FontSize="13"
                                           TextColor="{StaticResource BrushText}" LineHeight="1.4" />
                                    <Label Text="No synopsis available."
                                           IsVisible="{Binding Source={x:Reference DetailsPage}, Path=GeneralSynopsisEmptyVisible}"
                                           FontFamily="Inter" FontSize="12" TextColor="#8FA8C0" MaxLines="1" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                                         Padding="12,12,12,32" Spacing="12">
                        <Border IsVisible="{Binding LoadingDetails}" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingDetails}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading details..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=DetailsErrorVisible}"
                                Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=DetailsErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=DetailsEmptyVisible}"
                                Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No additional details available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=DetailsContentVisible}"
                                             Spacing="12">
                            <Border Style="{StaticResource PanelStyle}" Padding="12">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding LeftGenres}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding .}" FontFamily="Inter" FontSize="13"
                                                       TextColor="{StaticResource BrushText}" Padding="0,4" MaxLines="1" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" BindableLayout.ItemsSource="{Binding RightGenres}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding .}" FontFamily="Inter" FontSize="13"
                                                       TextColor="{StaticResource BrushText}" Padding="0,4" MaxLines="1" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="INFORMATION" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Information}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="110,*" Padding="0,3">
                                                    <Label Text="{Binding Item1}" FontFamily="Inter" FontSize="12"
                                                           TextColor="#8FA8C0" MaxLines="1" />
                                                    <Label Grid.Column="1" Text="{Binding Item2}" FontFamily="Inter" FontSize="12"
                                                           TextColor="{StaticResource BrushText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="STATS" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Stats}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="110,*" Padding="0,3">
                                                    <Label Text="{Binding Item1}" FontFamily="Inter" FontSize="12"
                                                           TextColor="#8FA8C0" MaxLines="1" />
                                                    <Label Grid.Column="1" Text="{Binding Item2}" FontFamily="Inter" FontSize="12"
                                                           TextColor="{StaticResource BrushText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Padding="12">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="OPENING" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0" MaxLines="1" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OPs}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#1A0066FF" StrokeShape="RoundRectangle 6"
                                                        Stroke="#330066FF" StrokeThickness="1" Padding="8,5" Margin="0,2">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnOpEdTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding .}" FontFamily="Inter" FontSize="13"
                                                           TextColor="#7AB4FF" MaxLines="2" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <Label Text="ENDING" FontFamily="InterBold" FontSize="10" TextColor="#8FA8C0"
                                           Margin="0,6,0,0" MaxLines="1" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding EDs}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border BackgroundColor="#1AFF6B00" StrokeShape="RoundRectangle 6"
                                                        Stroke="#33FF6B00" StrokeThickness="1" Padding="8,5" Margin="0,2">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnOpEdTapped" CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding .}" FontFamily="Inter" FontSize="13"
                                                           TextColor="#FFB47A" MaxLines="2" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingEpisodes}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingEpisodes}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading episodes..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=EpisodesErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=EpisodesErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=EpisodesEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No episodes available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=EpisodesContentVisible}"
                                             BindableLayout.ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedEpisodes}"
                                             BindableLayout.ItemTemplate="{StaticResource EpisodeTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingReviews}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingReviews}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading reviews..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=ReviewsErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=ReviewsErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=ReviewsEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No reviews available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=ReviewsContentVisible}"
                                             BindableLayout.ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedReviews}"
                                             BindableLayout.ItemTemplate="{StaticResource ReviewTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingRecommendations}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingRecommendations}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading recommendations..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No recommendations available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RecommendationsContentVisible}"
                                             BindableLayout.ItemsSource="{Binding Recommendations}"
                                             BindableLayout.ItemTemplate="{StaticResource RecommendationTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=5}"
                                         Padding="8,8,8,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingRelated}" Margin="4,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingRelated}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading related titles..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedErrorVisible}"
                                Margin="4,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=RelatedErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedEmptyVisible}"
                                Margin="4,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No related titles available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <FlexLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=RelatedContentVisible}"
                                    Wrap="Wrap" AlignItems="Start" JustifyContent="Start"
                                    BindableLayout.ItemsSource="{Binding RelatedAnime}"
                                    BindableLayout.ItemTemplate="{StaticResource RelatedTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=6}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingCharactersVisibility}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingCharactersVisibility}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading characters..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=CharactersErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=CharactersErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=CharactersEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No characters available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding AnimeMode}"
                                             BindableLayout.ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedCharacters}"
                                             BindableLayout.ItemTemplate="{StaticResource AnimeCharacterTemplate}" />
                        <VerticalStackLayout IsVisible="{Binding AnimeMode, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                             BindableLayout.ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedMangaCharacters}"
                                             BindableLayout.ItemTemplate="{StaticResource MangaCharacterTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=7}"
                                         Padding="0,8,0,32" Spacing="6">
                        <Border IsVisible="{Binding LoadingCharactersVisibility}" Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator IsRunning="{Binding LoadingCharactersVisibility}" Color="#0066FF"
                                                   WidthRequest="22" HeightRequest="22" />
                                <Label Text="Loading staff..." Style="{StaticResource StateTextStyle}" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=StaffErrorVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="{Binding Source={x:Reference DetailsPage}, Path=StaffErrorText}"
                                   Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <Border IsVisible="{Binding Source={x:Reference DetailsPage}, Path=StaffEmptyVisible}"
                                Margin="12,8" Style="{StaticResource PanelStyle}" Padding="18">
                            <Label Text="No staff available." Style="{StaticResource StateTextStyle}" />
                        </Border>
                        <VerticalStackLayout IsVisible="{Binding Source={x:Reference DetailsPage}, Path=StaffContentVisible}"
                                             BindableLayout.ItemsSource="{Binding Source={x:Reference DetailsPage}, Path=DisplayedStaff}"
                                             BindableLayout.ItemTemplate="{StaticResource StaffTemplate}" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout x:Name="HeaderFlow" Spacing="0" ZIndex="20" VerticalOptions="Start" HorizontalOptions="Fill"
                             BackgroundColor="{StaticResource EmSheet}">
            <Grid x:Name="HeroContainer" HeightRequest="460" HorizontalOptions="Fill" BackgroundColor="Transparent" IsClippedToBounds="True">
                <Grid x:Name="HeroVisual" HeightRequest="460" IsClippedToBounds="True" VerticalOptions="Start" HorizontalOptions="Fill">
                    <controls:BlurHeroView ImageUrl="{Binding DetailImage}" />
                    <Frame x:Name="PosterContainer"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           WidthRequest="340" HeightRequest="380" Padding="0" HasShadow="False"
                           BackgroundColor="Transparent" BorderColor="Transparent">
                        <Image Source="{Binding DetailImage, Converter={StaticResource ImageConverter}}"
                               Aspect="AspectFit" />
                    </Frame>
                    <BoxView BackgroundColor="Transparent" InputTransparent="False">
                        <BoxView.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnHeaderPanUpdated" />
                        </BoxView.GestureRecognizers>
                    </BoxView>
                    <BoxView InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00051522" Offset="0.0" />
                                <GradientStop Color="#00051522" Offset="0.5" />
                                <GradientStop Color="#B3051522" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <BoxView x:Name="HeroScrim" Opacity="0" InputTransparent="True">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00051522" Offset="0.0" />
                                <GradientStop Color="#4D051522" Offset="0.5" />
                                <GradientStop Color="#B3051522" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start" Margin="0,12,12,0" Spacing="8">
                        <Button Text="▶" Clicked="OnTrailerClicked" IsVisible="{Binding HasTrailer}"
                                FontFamily="InterBold" FontSize="14" BackgroundColor="#33FFFFFF"
                                TextColor="White" BorderColor="#80FFFFFF" BorderWidth="1"
                                CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="0" />
                        <ActivityIndicator IsRunning="{Binding LoadingGlobal}" IsVisible="{Binding LoadingGlobal}"
                                           Color="{StaticResource EmAccent}" WidthRequest="28" HeightRequest="28" />
                    </HorizontalStackLayout>
                    <Grid x:Name="TitleSection" VerticalOptions="End" RowDefinitions="Auto,Auto,Auto" Padding="20,24,20,16">
                        <Label Grid.Row="0" x:Name="TitleLabel" Text="{Binding Title}"
                               FontFamily="InterBold" FontSize="26" TextColor="White"
                               MaxLines="2" LineBreakMode="TailTruncation" Margin="0,0,0,4" />
                        <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                            <Frame Padding="8,2" CornerRadius="6" HasShadow="False" BackgroundColor="#0066FF" BorderColor="Transparent">
                                <Label Text="{Binding Type}" FontFamily="InterBold" FontSize="11" TextColor="White" />
                            </Frame>
                            <Frame Padding="8,2" CornerRadius="6" HasShadow="False" BackgroundColor="#00C853" BorderColor="Transparent"
                                   IsVisible="{Binding Status, Converter={StaticResource AiringStatus}}">
                                <Label Text="AIRING" FontFamily="InterBold" FontSize="11" TextColor="White" />
                            </Frame>
                            <Frame Padding="8,2" CornerRadius="6" HasShadow="False" BackgroundColor="#FF0000" BorderColor="Transparent">
                                <Frame.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiAnd}">
                                        <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                        <Binding Path="TimeTillNextAir" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                                    </MultiBinding>
                                </Frame.IsVisible>
                                <Label Text="{Binding TimeTillNextAir}" FontFamily="InterBold" FontSize="11" TextColor="White" />
                            </Frame>
                            <Label Text="•" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" VerticalOptions="Center" Margin="6,0" />
                            <Label Text="{Binding StartYear}" FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                            <Label Text="•" FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF" VerticalOptions="Center" Margin="6,0" />
                            <Label Text="{Binding AllEpisodes, StringFormat='{0} Episodes'}" IsVisible="{Binding AnimeMode}"
                                   FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                            <Label Text="{Binding AllEpisodes, StringFormat='{0} Chapters'}"
                                   IsVisible="{Binding AnimeMode, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                   FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                <Label Text="★" FontFamily="InterBold" FontSize="9" TextColor="#FFD700" VerticalOptions="Center" />
                                <Label Text="SCORE" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Row="0" Grid.Column="1" Text="STATUS" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="2" Text="LAST AIRED" FontFamily="InterBold" FontSize="9" TextColor="#80FFFFFF" VerticalOptions="Center">
                                <Label.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiAnd}">
                                        <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                        <Binding Path="LastAired" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                                    </MultiBinding>
                                </Label.IsVisible>
                            </Label>
                            <Label Grid.Row="1" Grid.Column="0" Text="{Binding GlobalScoreBind}" FontFamily="InterBold" FontSize="14" TextColor="White" VerticalOptions="Center" />
                            <Button Grid.Row="1" Grid.Column="1" Text="{Binding MyStatusBind}" Clicked="OnStatusClicked"
                                    IsEnabled="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                    FontFamily="InterBold" FontSize="14" BackgroundColor="Transparent" TextColor="White"
                                    BorderWidth="0" Padding="0" HeightRequest="24" HorizontalOptions="Start" />
                            <Label Grid.Row="1" Grid.Column="2" Text="{Binding LastAired}" FontFamily="InterBold" FontSize="14" TextColor="White"
                                   VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation">
                                <Label.IsVisible>
                                    <MultiBinding Converter="{StaticResource MultiAnd}">
                                        <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                        <Binding Path="LastAired" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                                    </MultiBinding>
                                </Label.IsVisible>
                            </Label>
                            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="#1A000000" Stroke="#29FFFFFF" StrokeThickness="1"
                                    Padding="0" VerticalOptions="Center" HeightRequest="32"
                                    IsVisible="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <Grid ColumnDefinitions="32,Auto,32" ColumnSpacing="0">
                                    <Button Grid.Column="0" Command="{Binding DecrementEpsCommand}" FontFamily="InterBold" FontSize="16" Text="−"
                                            BackgroundColor="Transparent" TextColor="#80FFFFFF" BorderWidth="0" CornerRadius="0"
                                            WidthRequest="32" HeightRequest="32" Padding="0" />
                                    <Label Grid.Column="1" Text="{Binding MyEpisodesBind}" FontFamily="InterBold" FontSize="13"
                                           TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" VerticalTextAlignment="Center" Padding="6,0" />
                                    <Button Grid.Column="2" Command="{Binding IncrementEpsCommand}" FontFamily="InterBold" FontSize="16" Text="+"
                                            BackgroundColor="#0066FF" TextColor="White" BorderWidth="0" CornerRadius="0"
                                            WidthRequest="32" HeightRequest="32" Padding="0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <Border x:Name="ActionBar" HorizontalOptions="Fill" BackgroundColor="{StaticResource EmSheet}" StrokeShape="RoundRectangle 24,24,0,0" Stroke="Transparent" Padding="14,12,14,8">
                <Grid ColumnDefinitions="*,*,Auto,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="Add to List" Command="{Binding AddAnimeCommand}" IsVisible="{Binding AddAnimeVisibility}"
                            IsEnabled="{Binding IsAddAnimeButtonEnabled}" FontFamily="InterSemiBold" FontSize="12" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0" />
                    <Button Grid.Column="0" Text="★ Unranked" Clicked="OnScoreClicked" FontFamily="InterSemiBold" FontSize="12" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="AddAnimeVisibility" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                                <Binding Path="IsMyScoreSet" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Grid.Column="0" Text="{Binding MyScoreBind, StringFormat='★ {0}'}" Clicked="OnScoreClicked" FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#141d2b" TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="AddAnimeVisibility" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                                <Binding Path="IsMyScoreSet" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Grid.Column="1" x:Name="FavouriteButton" Text="♡ Favorite" Command="{Binding ToggleFavouriteCommand}"
                            IsEnabled="{Binding IsFavouriteButtonEnabled}" FontFamily="InterSemiBold" FontSize="12" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding IsFavourite}" Value="True">
                                <Setter Property="Text" Value="♥ Favourited" />
                                <Setter Property="TextColor" Value="{StaticResource EmAccent}" />
                                <Setter Property="BorderColor" Value="{StaticResource EmAccent}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="▶" Clicked="OnTrailerClicked" IsVisible="{Binding HasTrailer}" FontFamily="InterBold" FontSize="14"
                            BackgroundColor="#141d2b" TextColor="#FF6B00" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                    <Button Grid.Column="3" Text="↻" Command="{Binding RefreshCommand}" FontFamily="InterBold" FontSize="14" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                    <Button Grid.Column="4" Text="⋮" Command="{Binding ShowMoreCommand}" FontFamily="InterBold" FontSize="18" BackgroundColor="#141d2b"
                            TextColor="White" BorderColor="#29FFFFFF" BorderWidth="1" CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                </Grid>
            </Border>

            <ScrollView x:Name="TabStripScroll" HorizontalOptions="Fill" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Margin="0,0,0,0" Padding="14,4,14,0" BackgroundColor="{StaticResource EmSheet}">
                <HorizontalStackLayout Spacing="20">
                    <Label x:Name="TabGeneral" Text="General" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabDetails" Text="Details" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabEpisodes" Text="Episodes" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabReviews" Text="Reviews" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabRecs" Text="Recommendations" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="4" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabRelated" Text="Related" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="5" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabCharacters" Text="Characters" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="6" /></Label.GestureRecognizers>
                    </Label>
                    <Label x:Name="TabStaff" Text="Staff" Style="{StaticResource TabLabelStyle}">
                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="7" /></Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <Grid IsVisible="{Binding LoadingGlobal}" BackgroundColor="#CC000510" ZIndex="100">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="#0066FF" WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading..." FontFamily="Inter" FontSize="12" TextColor="White" MaxLines="1" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="VideoOverlay" IsVisible="False" BackgroundColor="#000000" ZIndex="110">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Text="Close" Clicked="CloseVideoOverlay" HorizontalOptions="End"
                    Margin="0,12,12,0" BackgroundColor="Transparent" TextColor="White"
                    FontFamily="InterBold" FontSize="14" Padding="8,4" />
            <!-- The WebView is created by ShowVideoOverlay, not here: an Android WebView
                 spawns a Chromium child process and costs 100-400ms plus tens of MB, and
                 MAUI builds handlers for the whole tree when the page attaches, so
                 declaring it here stalled EVERY details open for a video nobody played. -->
        </Grid>
    </Grid>
</ContentPage>
