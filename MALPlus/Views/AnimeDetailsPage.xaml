<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             xmlns:controls="clr-namespace:MALPlus.Controls"
             x:Class="MALPlus.Views.AnimeDetailsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:TabColorConverter x:Key="TabColorConverter" />
        <converters:IntEqualityConverter x:Key="IntEq" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:AiringStatusVisibilityConverter x:Key="AiringStatus" />
        <converters:MultiAndConverter x:Key="MultiAnd" />
    </ContentPage.Resources>

    <!-- ============================================================== -->
    <!-- ROOT: 3-row Grid                                               -->
    <!--   Row 0: Hero (FIXED 380dp, no scroll)                         -->
    <!--   Row 1: Action bar + Tab strip (STICKY, no scroll)            -->
    <!--   Row 2: Pager (each tab scrolls independently)                -->
    <!-- ============================================================== -->
    <Grid RowDefinitions="Auto,Auto,*" BackgroundColor="{StaticResource EmSheet}">

        <!-- ============================================================== -->
        <!-- HERO (600dp, no scroll)                                       -->
        <!--   - Poster full-bleed (centerCrop)                            -->
        <!--   - Bottom gradient overlay                                   -->
        <!--   - Title section pinned bottom (title, badges, score row)   -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" x:Name="HeroContainer" HeightRequest="460" BackgroundColor="#000000">
            <!-- BLURRED BACKGROUND: same poster, real blur radius 25 (v2 parity) -->
            <controls:BlurHeroView ImageUrl="{Binding DetailImage}" />

            <!-- SHARP CENTERED POSTER (340dp wide, fitCenter, 40dp top/bottom margins) -->
            <Frame x:Name="PosterContainer"
                   HorizontalOptions="Center" VerticalOptions="Fill"
                   WidthRequest="340" Padding="0" HasShadow="False"
                   BackgroundColor="Transparent" BorderColor="Transparent"
                   Margin="0,40,0,40">
                <Image Source="{Binding DetailImage, Converter={StaticResource ImageConverter}}"
                       Aspect="AspectFit" />
            </Frame>

            <!-- Bottom gradient overlay (v2 hero_gradient_overlay) -->
            <BoxView>
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00051522" Offset="0.0" />
                        <GradientStop Color="#00051522" Offset="0.5" />
                        <GradientStop Color="#B3051522" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- Collapse scrim (v2 hero_collapse_scrim, Opacity = collapse ratio) -->
            <BoxView x:Name="HeroScrim" Opacity="0">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00051522" Offset="0.0" />
                        <GradientStop Color="#4D051522" Offset="0.5" />
                        <GradientStop Color="#B3051522" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- TOP-RIGHT: trailer button + loading spinner -->
            <HorizontalStackLayout HorizontalOptions="End" VerticalOptions="Start"
                                   Margin="0,12,12,0" Spacing="8">
                <Button Text="▶"
                        Command="{Binding ShowMoreCommand}"
                        IsVisible="{Binding HasTrailer}"
                        FontFamily="InterBold" FontSize="14"
                        BackgroundColor="#33FFFFFF" TextColor="White"
                        BorderColor="#80FFFFFF" BorderWidth="1"
                        CornerRadius="18" WidthRequest="36" HeightRequest="36" Padding="0" />
                <ActivityIndicator IsRunning="{Binding LoadingGlobal}"
                                   IsVisible="{Binding LoadingGlobal}"
                                   Color="{StaticResource EmAccent}"
                                   WidthRequest="28" HeightRequest="28" />
            </HorizontalStackLayout>

            <!-- TITLE SECTION (pinned to bottom of hero) -->
            <Grid x:Name="TitleSection" VerticalOptions="End"
                  RowDefinitions="Auto,Auto,Auto" Padding="20,24,20,16">
                <!-- Title -->
                <Label Grid.Row="0" x:Name="TitleLabel" Text="{Binding Title}"
                       FontFamily="InterBold" FontSize="26"
                       TextColor="White" MaxLines="2" LineBreakMode="TailTruncation"
                       Margin="0,0,0,4" />
                <!-- Badges row: Type + AIRING + Countdown + Year + Episodes -->
                <HorizontalStackLayout Grid.Row="1" Spacing="6" Margin="0,0,0,12">
                    <Frame Padding="8,2" CornerRadius="6" HasShadow="False"
                           BackgroundColor="#0066FF" BorderColor="Transparent">
                        <Label Text="{Binding Type}" FontFamily="InterBold" FontSize="11"
                               TextColor="White" />
                    </Frame>
                    <Frame Padding="8,2" CornerRadius="6" HasShadow="False"
                           BackgroundColor="#00C853" BorderColor="Transparent"
                           IsVisible="{Binding Status, Converter={StaticResource AiringStatus}}">
                        <Label Text="AIRING" FontFamily="InterBold" FontSize="11"
                               TextColor="White" />
                    </Frame>
                    <Frame Padding="8,2" CornerRadius="6" HasShadow="False"
                           BackgroundColor="#FF0000" BorderColor="Transparent">
                        <Frame.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="Status" Converter="{StaticResource AiringStatus}" />
                                <Binding Path="TimeTillNextAir" Converter="{StaticResource BoolVis}" ConverterParameter="nonempty" />
                            </MultiBinding>
                        </Frame.IsVisible>
                        <Label Text="{Binding TimeTillNextAir}"
                               FontFamily="InterBold" FontSize="11" TextColor="White" />
                    </Frame>
                    <Label Text="•" FontFamily="Inter" FontSize="11"
                           TextColor="#80FFFFFF" VerticalOptions="Center" Margin="6,0" />
                    <Label Text="{Binding StartYear}" FontFamily="Inter" FontSize="12"
                           TextColor="#CCFFFFFF" VerticalOptions="Center" />
                    <Label Text="•" FontFamily="Inter" FontSize="11"
                           TextColor="#80FFFFFF" VerticalOptions="Center" Margin="6,0" />
                    <Label Text="{Binding AllEpisodes, StringFormat='{0} Episodes'}"
                           IsVisible="{Binding AnimeMode}"
                           FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF"
                           VerticalOptions="Center" />
                    <Label Text="{Binding AllEpisodes, StringFormat='{0} Chapters'}"
                           IsVisible="{Binding AnimeMode, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                           FontFamily="Inter" FontSize="12" TextColor="#CCFFFFFF"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <!-- Score block: labels row + values row (v2), stepper right spanning -->
                <Grid Grid.Row="2" ColumnDefinitions="*,*,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12"
                      VerticalOptions="Center">
                    <!-- Labels row -->
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3" VerticalOptions="Center">
                        <Label Text="★" FontFamily="InterBold" FontSize="9" TextColor="#FFD700" VerticalOptions="Center" />
                        <Label Text="SCORE" FontFamily="InterBold" FontSize="9"
                               TextColor="#80FFFFFF" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Row="0" Grid.Column="1" Text="STATUS" FontFamily="InterBold" FontSize="9"
                           TextColor="#80FFFFFF" VerticalOptions="Center" />
                    <Label Grid.Row="0" Grid.Column="2" Text="LAST AIRED" FontFamily="InterBold" FontSize="9"
                           TextColor="#80FFFFFF" VerticalOptions="Center"
                           IsVisible="{Binding LastAired, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}" />
                    <!-- Values row -->
                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding GlobalScoreBind}"
                           FontFamily="InterBold" FontSize="14" TextColor="White" VerticalOptions="Center" />
                    <Button Grid.Row="1" Grid.Column="1" Text="{Binding MyStatusBind}"
                            Clicked="OnStatusClicked"
                            IsEnabled="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                            FontFamily="InterBold" FontSize="14"
                            BackgroundColor="Transparent" TextColor="White"
                            BorderWidth="0" Padding="0" HeightRequest="24" HorizontalOptions="Start" />
                    <Label Grid.Row="1" Grid.Column="2" Text="{Binding LastAired}"
                           FontFamily="InterBold" FontSize="14" TextColor="White"
                           IsVisible="{Binding LastAired, Converter={StaticResource BoolVis}, ConverterParameter=nonempty}"
                           VerticalOptions="Center" />
                    <!-- Stepper pill (right, spans both rows) -->
                    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" StrokeShape="RoundRectangle 14"
                            BackgroundColor="#1A000000" Stroke="#29FFFFFF" StrokeThickness="1"
                            Padding="0" VerticalOptions="Center" HeightRequest="32"
                            IsVisible="{Binding AddAnimeVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Grid ColumnDefinitions="32,Auto,32" ColumnSpacing="0">
                            <Button Grid.Column="0" Command="{Binding DecrementEpsCommand}"
                                    FontFamily="InterBold" FontSize="16" Text="−"
                                    BackgroundColor="Transparent" TextColor="#80FFFFFF"
                                    BorderWidth="0" CornerRadius="0" WidthRequest="32" HeightRequest="32"
                                    Padding="0" />
                            <Label Grid.Column="1" Text="{Binding MyEpisodesBind}"
                                   FontFamily="InterBold" FontSize="13" TextColor="White"
                                   VerticalOptions="Center" HorizontalOptions="Center"
                                   VerticalTextAlignment="Center" Padding="6,0" />
                            <Button Grid.Column="2" Command="{Binding IncrementEpsCommand}"
                                    FontFamily="InterBold" FontSize="16" Text="+"
                                    BackgroundColor="#0066FF" TextColor="White"
                                    BorderWidth="0" CornerRadius="0" WidthRequest="32" HeightRequest="32"
                                    Padding="0" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!-- ACTION BAR (2 buttons + 2 icons, no Add to List)              -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" BackgroundColor="{StaticResource EmSheet}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Row 0: action buttons -->
            <Border Grid.Row="0" BackgroundColor="{StaticResource EmSheet}"
                    StrokeShape="RoundRectangle 24,24,0,0" Stroke="Transparent"
                    Padding="14,12,14,8">
                <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="6">
                    <Button Grid.Column="0" Text="Add to List"
                            Command="{Binding AddAnimeCommand}"
                            IsVisible="{Binding AddAnimeVisibility}"
                            IsEnabled="{Binding IsAddAnimeButtonEnabled}"
                            FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#141d2b" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="12" HeightRequest="40" Padding="10,0" />
                    <Button Grid.Column="0" Text="★ Unranked"
                            Clicked="OnScoreClicked"
                            FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#141d2b" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="AddAnimeVisibility" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                                <Binding Path="IsMyScoreSet" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Grid.Column="0" Text="{Binding MyScoreBind, StringFormat='★ {0}'}"
                            Clicked="OnScoreClicked"
                            FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#141d2b" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="12" HeightRequest="40" Padding="10,0">
                        <Button.IsVisible>
                            <MultiBinding Converter="{StaticResource MultiAnd}">
                                <Binding Path="AddAnimeVisibility" Converter="{StaticResource BoolVis}" ConverterParameter="invert" />
                                <Binding Path="IsMyScoreSet" />
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                    <Button Grid.Column="1" Text="♡ Favorite"
                            Command="{Binding ToggleFavouriteCommand}"
                            FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#141d2b" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="12" HeightRequest="40" Padding="10,0" />
                    <Button Grid.Column="2" Text="↻"
                            Command="{Binding RefreshCommand}"
                            FontFamily="InterBold" FontSize="14"
                            BackgroundColor="#141d2b" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                    <Button Grid.Column="3" Text="⋮"
                            Command="{Binding ShowMoreCommand}"
                            FontFamily="InterBold" FontSize="18"
                            BackgroundColor="#141d2b" TextColor="White"
                            BorderColor="#29FFFFFF" BorderWidth="1"
                            CornerRadius="12" HeightRequest="40" WidthRequest="40" Padding="0" />
                </Grid>
            </Border>

            <!-- Row 1: tab strip -->
            <ScrollView Grid.Row="1" Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        Margin="0,0,0,0" Padding="14,4,14,0"
                        BackgroundColor="{StaticResource EmSheet}">
                <HorizontalStackLayout Spacing="20">
                    <Label Text="General" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{Binding DetailsPivotSelectedIndex, Converter={StaticResource TabColorConverter}, ConverterParameter=0}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Episodes" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{Binding DetailsPivotSelectedIndex, Converter={StaticResource TabColorConverter}, ConverterParameter=1}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Characters" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{Binding DetailsPivotSelectedIndex, Converter={StaticResource TabColorConverter}, ConverterParameter=2}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Staff" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{Binding DetailsPivotSelectedIndex, Converter={StaticResource TabColorConverter}, ConverterParameter=3}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Recs" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{Binding DetailsPivotSelectedIndex, Converter={StaticResource TabColorConverter}, ConverterParameter=4}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="4" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Text="Related" FontFamily="InterSemiBold" FontSize="13"
                           TextColor="{Binding DetailsPivotSelectedIndex, Converter={StaticResource TabColorConverter}, ConverterParameter=5}"
                           HorizontalOptions="Center" VerticalOptions="Center" Padding="0,6">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="5" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ============================================================== -->
        <!-- PAGER (each tab scrolls independently)                        -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2" BackgroundColor="{StaticResource EmSheet}">
            <!-- General Tab (0) -->
            <ScrollView x:Name="GeneralScroll"
                        Scrolled="OnTabContentScrolled"
                        IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=0}"
                        Padding="12,12,12,16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                BackgroundColor="{StaticResource EmSheet}" Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="🏆" FontSize="20" TextColor="#FFD700" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="RANK" FontFamily="InterBold" FontSize="10"
                                           TextColor="#A0FFFFFF" />
                                    <Label Text="{Binding GeneralRank}" FontFamily="InterBold" FontSize="18"
                                           TextColor="{StaticResource BrushText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                BackgroundColor="{StaticResource EmSheet}" Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="👥" FontSize="20" TextColor="#FFD700" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="POPULARITY" FontFamily="InterBold" FontSize="10"
                                           TextColor="#A0FFFFFF" />
                                    <Label Text="{Binding GeneralPopularity}" FontFamily="InterBold" FontSize="18"
                                           TextColor="{StaticResource BrushText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                BackgroundColor="{StaticResource EmSheet}" Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="❤" FontSize="20" TextColor="#FFD700" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="FAVORITES" FontFamily="InterBold" FontSize="10"
                                           TextColor="#A0FFFFFF" />
                                    <Label Text="{Binding GeneralFavorites}" FontFamily="InterBold" FontSize="18"
                                           TextColor="{StaticResource BrushText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                BackgroundColor="{StaticResource EmSheet}" Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="👁" FontSize="20" TextColor="#FFD700" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="MEMBERS" FontFamily="InterBold" FontSize="10"
                                           TextColor="#A0FFFFFF" />
                                    <Label Text="{Binding GeneralMembers}" FontFamily="InterBold" FontSize="18"
                                           TextColor="{StaticResource BrushText}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Border Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                BackgroundColor="{StaticResource EmSheet}" Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="🏢" FontSize="20" TextColor="#FFD700" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="STUDIOS" FontFamily="InterBold" FontSize="10"
                                           TextColor="#A0FFFFFF" />
                                    <Label Text="{Binding GeneralStudios}" FontFamily="InterBold" FontSize="16"
                                           TextColor="{StaticResource BrushText}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                BackgroundColor="{StaticResource EmSheet}" Padding="12"
                                StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="📅" FontSize="20" TextColor="#FFD700" />
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="PREMIERED" FontFamily="InterBold" FontSize="10"
                                           TextColor="#A0FFFFFF" />
                                    <Label Text="{Binding GeneralSeason}" FontFamily="InterBold" FontSize="16"
                                           TextColor="{StaticResource BrushText}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Border Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                            BackgroundColor="{StaticResource EmSheet}" Padding="12"
                            StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="📝" FontSize="18" TextColor="#FFD700" />
                                <Label Text="SYNOPSIS" FontFamily="InterBold" FontSize="10"
                                       TextColor="#A0FFFFFF" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Synopsis}" FontFamily="Inter" FontSize="13"
                                   TextColor="{StaticResource BrushText}" LineHeight="1.4" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- Episodes Tab (1) -->
            <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=1}"
                  RowDefinitions="Auto,*" Padding="0,8,0,16">
                <ActivityIndicator Grid.Row="0" IsRunning="{Binding LoadingEpisodes}"
                                   IsVisible="{Binding LoadingEpisodes}"
                                   Color="{StaticResource EmAccent}" VerticalOptions="Center"
                                   HorizontalOptions="Center" Margin="0,20" />
                <CollectionView x:Name="EpisodesList" Grid.Row="1" ItemsSource="{Binding Episodes}"
                                Scrolled="OnTabItemsScrolled"
                                EmptyView="No episodes available" Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="14,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding EpisodeId, StringFormat='Ep {0}'}"
                                           FontFamily="InterBold" FontSize="14" TextColor="#0066FF"
                                           VerticalOptions="Center" MinimumWidthRequest="50" />
                                    <Label Grid.Column="1" Text="{Binding Title}"
                                           FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Characters Tab (2) -->
            <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=2}"
                  RowDefinitions="Auto,*" Padding="0,8,0,16">
                <ActivityIndicator Grid.Row="0" IsRunning="{Binding LoadingCharacters}"
                                   IsVisible="{Binding LoadingCharacters}"
                                   Color="{StaticResource EmAccent}" VerticalOptions="Center"
                                   HorizontalOptions="Center" Margin="0,20" />
                <CollectionView x:Name="CharactersList" Grid.Row="1" ItemsSource="{Binding AnimeCharactersData}"
                                Scrolled="OnTabItemsScrolled"
                                EmptyView="No characters" Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding Name}"
                                           FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding Role}"
                                           FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Staff Tab (3) -->
            <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=3}"
                  RowDefinitions="Auto,*" Padding="0,8,0,16">
                <ActivityIndicator Grid.Row="0" IsRunning="{Binding LoadingStaff}"
                                   IsVisible="{Binding LoadingStaff}"
                                   Color="{StaticResource EmAccent}" VerticalOptions="Center"
                                   HorizontalOptions="Center" Margin="0,20" />
                <CollectionView x:Name="StaffList" Grid.Row="1" ItemsSource="{Binding AnimeStaffData}"
                                Scrolled="OnTabItemsScrolled"
                                EmptyView="No staff" Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="14,10">
                                <Label Text="{Binding Name}" FontFamily="Inter" FontSize="14"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Recs Tab (4) -->
            <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=4}"
                  RowDefinitions="Auto,*" Padding="0,8,0,16">
                <ActivityIndicator Grid.Row="0" IsRunning="{Binding LoadingRecommendations}"
                                   IsVisible="{Binding LoadingRecommendations}"
                                   Color="{StaticResource EmAccent}" VerticalOptions="Center"
                                   HorizontalOptions="Center" Margin="0,20" />
                <CollectionView x:Name="RecsList" Grid.Row="1" ItemsSource="{Binding Recommendations}"
                                Scrolled="OnTabItemsScrolled"
                                EmptyView="No recommendations" Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="14,10">
                                <Label Text="{Binding Title}" FontFamily="Inter" FontSize="14"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <!-- Related Tab (5) -->
            <Grid IsVisible="{Binding DetailsPivotSelectedIndex, Converter={StaticResource IntEq}, ConverterParameter=5}"
                  RowDefinitions="Auto,*" Padding="0,8,0,16">
                <ActivityIndicator Grid.Row="0" IsRunning="{Binding LoadingRelated}"
                                   IsVisible="{Binding LoadingRelated}"
                                   Color="{StaticResource EmAccent}" VerticalOptions="Center"
                                   HorizontalOptions="Center" Margin="0,20" />
                <CollectionView x:Name="RelatedList" Grid.Row="1" ItemsSource="{Binding AnimeRelatedData}"
                                Scrolled="OnTabItemsScrolled"
                                EmptyView="No related anime" Margin="0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="14,10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Label Grid.Column="0" Text="{Binding Title}"
                                           FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding RelationType}"
                                           FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- Loading overlay (full screen, blocks while initial data loads) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding LoadingGlobal}"
              BackgroundColor="#CC000510" ZIndex="99">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="40" HeightRequest="40" />
                <Label Text="Loading..." FontFamily="Inter" FontSize="12"
                       TextColor="{StaticResource BrushText}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
