<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.SettingsPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="14">

            <Label Text="Settings" FontFamily="InterBold" FontSize="22"
                   TextColor="{StaticResource BrushText}" />

            <!-- General -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="GENERAL" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Prefer English titles" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PreferEnglishTitles}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Higher quality images" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PullHigherQualityImages}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Squeeze one more grid item" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding SqueezeOneMoreGridItem}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Swipe to inc/dec episodes" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding EnableSwipeToIncDec}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Homepage -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="HOMEPAGE" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Lock display mode" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding LockDisplayMode}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Show season with type" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding DisplaySeasonWithType}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Start page" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" Title="Start page" WidthRequest="110"
                                SelectedItem="{Binding StartPageOption}"
                                TextColor="{StaticResource BrushText}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Feeds -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="FEEDS" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Include pinned profiles" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding FeedsIncludePinnedProfiles}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Calendar -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="CALENDAR" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Include watching" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludeWatching}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Include planned" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarIncludePlanned}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Start week on Monday" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding CalendarSwitchMonSun}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Show season with type" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding DisplaySeasonWithType}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Start page" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Picker Grid.Column="1" SelectedItem="{Binding DefaultMenuTabOption}"
                                TitleColor="#A0FFFFFF" TextColor="{StaticResource BrushText}"
                                WidthRequest="130">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>anime</x:String>
                                    <x:String>manga</x:String>
                                    <x:String>discover</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Notifications -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="NOTIFICATIONS" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Enable notifications" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding EnableNotifications}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Articles -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ARTICLES" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Launch external links externally" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ArticlesLaunchExternalLinks}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Forums -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="FORUMS" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                        <Label Grid.Column="0" Text="Pull peek posts on startup" FontFamily="Inter" FontSize="14"
                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding PullPeekPostsOnStartup}"
                                OnColor="{StaticResource EmAccent}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Cache -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="CACHE" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label Text="{Binding TotalFilesCached, StringFormat='{0} files cached'}"
                           FontFamily="Inter" FontSize="13" TextColor="#80FFFFFF" />
                    <Button Text="Clear caches" Clicked="OnClearCachesClicked"
                            FontFamily="InterSemiBold" FontSize="13"
                            BackgroundColor="#FF6B00" TextColor="White"
                            CornerRadius="8" HeightRequest="36" Padding="14,0"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- About -->
            <Border BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ABOUT" FontFamily="InterBold" FontSize="11"
                           TextColor="#A0FFFFFF" />
                    <Label Text="MAL+ MAUI Migration build" FontFamily="InterBold" FontSize="14"
                           TextColor="{StaticResource BrushText}" />
                    <Label Text="MALClient fork by idarkalex, ported to .NET MAUI"
                           FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                     <Label Text="Built with .NET MAUI"
                            FontFamily="Inter" FontSize="12" TextColor="#80FFFFFF" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
