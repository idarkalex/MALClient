<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.ClubsIndexPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:IntEqualityConverter x:Key="IntEq" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading, FallbackValue=false}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding Loading, Converter={StaticResource BoolVis}, ConverterParameter=invert, FallbackValue=true}">
            <!-- Tab strip: My Clubs / Search / Activity (forum posts from joined clubs) -->
            <ScrollView Grid.Row="0" Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        Padding="12,12">
                <HorizontalStackLayout x:Name="TabStrip" Spacing="8" />
            </ScrollView>

            <!-- My Clubs tab -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding Loading, FallbackValue=false}" Refreshing="OnRefreshMy"
                         IsVisible="{Binding ClubsTabIndex, Converter={StaticResource IntEq}, ConverterParameter=0}">
                <CollectionView ItemsSource="{Binding MyClubs}" SelectionMode="Single"
                                SelectionChanged="OnClubTapped"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReachedCommand="{Binding MoreCommand}">
                    <CollectionView.EmptyView>
                        <Label Text="No clubs joined" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                                    <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                           Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontFamily="InterBold" FontSize="14"
                                           TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Search tab -->
            <Grid Grid.Row="1" IsVisible="{Binding ClubsTabIndex, Converter={StaticResource IntEq}, ConverterParameter=1}">
                <Grid RowDefinitions="Auto,*" Padding="12,0,12,12">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Entry x:Name="SearchEntry" Placeholder="Search clubs..."
                               Text="{Binding SearchQuery, Mode=TwoWay}"
                               FontFamily="Inter" FontSize="14"
                               BackgroundColor="{StaticResource EmSheet}"
                               TextColor="{StaticResource BrushText}"
                               PlaceholderColor="#80FFFFFF"
                               ReturnType="Search" Completed="OnSearchCompleted" />
                        <Button Grid.Column="1" Text="🔍" Command="{Binding SearchCommand}"
                                FontFamily="InterBold" FontSize="16"
                                BackgroundColor="#0066FF" TextColor="White"
                                CornerRadius="8" WidthRequest="48" HeightRequest="48" Padding="0" />
                    </Grid>
                    <RefreshView IsRefreshing="{Binding Loading, FallbackValue=false}" Refreshing="OnSearchRefresh">
                        <CollectionView ItemsSource="{Binding Clubs}" SelectionMode="Single"
                                        SelectionChanged="OnClubTapped"
                                        RemainingItemsThreshold="3"
                                        RemainingItemsThresholdReachedCommand="{Binding MoreCommand}">
                            <CollectionView.EmptyView>
                                <Label Text="No clubs found" FontFamily="Inter" FontSize="13"
                                       TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" BackgroundColor="{StaticResource EmSheet}"
                                            Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 8" Padding="12">
                                        <Grid ColumnDefinitions="40,*" ColumnSpacing="10">
                                            <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   Aspect="AspectFill" WidthRequest="36" HeightRequest="36" />
                                            <Label Grid.Column="1" Text="{Binding Name}" FontFamily="InterBold" FontSize="14"
                                                   TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </RefreshView>
                </Grid>
            </Grid>

            <!-- Activity tab (forum posts from joined clubs) -->
            <RefreshView Grid.Row="1" IsRefreshing="{Binding Loading, FallbackValue=false}" Refreshing="OnActivityRefresh"
                         IsVisible="{Binding ClubsTabIndex, Converter={StaticResource IntEq}, ConverterParameter=2}">
                <CollectionView ItemsSource="{Binding ClubActivity}" SelectionMode="Single"
                                SelectionChanged="OnActivityTapped"
                                RemainingItemsThreshold="3"
                                RemainingItemsThresholdReachedCommand="{Binding MoreCommand}">
                    <CollectionView.EmptyView>
                        <Label Text="No club activity" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" WidthRequest="28" HeightRequest="28"
                                                StrokeShape="RoundRectangle 14"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                                            <Image Source="{Binding ClubImgUrl, Converter={StaticResource ImageConverter}}"
                                                   Aspect="AspectFill" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding ClubName}" FontFamily="InterBold" FontSize="11"
                                               TextColor="{StaticResource EmAccent}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding PostDate}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding TopicTitle}" FontFamily="InterBold" FontSize="13"
                                           TextColor="{StaticResource BrushText}" MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2" Text="{Binding PostPreview}" FontFamily="Inter" FontSize="11"
                                           TextColor="#80FFFFFF" MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Bottom loading indicator -->
            <Grid Grid.Row="2" HeightRequest="48" IsVisible="{Binding Loading, FallbackValue=false}"
                  VerticalOptions="End">
                <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                                   WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
