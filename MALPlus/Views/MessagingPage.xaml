<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.MessagingPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingVisibility}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,*" IsVisible="{Binding LoadingVisibility, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="Messages" FontFamily="InterBold" FontSize="22"
                       TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="✚" Clicked="OnComposeClicked"
                        FontFamily="InterBold" FontSize="20" BackgroundColor="#0066FF" TextColor="White"
                        CornerRadius="20" WidthRequest="40" HeightRequest="40" Padding="0" />
            </Grid>

            <RefreshView Grid.Row="1" IsRefreshing="{Binding LoadingVisibility}" Refreshing="OnRefreshing">
                <CollectionView ItemsSource="{Binding MessageIndex}" SelectionMode="Single"
                                SelectionChanged="OnMessageTapped">
                    <CollectionView.EmptyView>
                        <Label Text="No messages" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding Subject}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" MaxLines="1"
                                               LineBreakMode="TailTruncation" />
                                        <Label Grid.Column="1" Text="{Binding Date}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding Target, StringFormat='From: {0}'}" FontFamily="Inter" FontSize="12"
                                           TextColor="{StaticResource EmAccent}" />
                                    <Label Grid.Row="2" Text="{Binding Content}" FontFamily="Inter" FontSize="12"
                                           TextColor="#C0FFFFFF" MaxLines="2" LineBreakMode="TailTruncation" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
