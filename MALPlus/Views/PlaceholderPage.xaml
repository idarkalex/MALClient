<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MALPlus.Views.PlaceholderPage"
             BackgroundColor="{StaticResource EmBackground}">
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12" Padding="24">
        <Label Text="MAL+ MAUI migration shell"
               FontFamily="InterBold" FontSize="20" TextColor="{StaticResource BrushText}"
               HorizontalOptions="Center" />
        <Label Text="Screen content arrives in Phase 3."
               FontFamily="Inter" FontSize="14" TextColor="{StaticResource BrushText}"
               HorizontalOptions="Center" />
        <Label x:Name="CoreLabel"
               FontFamily="Inter" FontSize="12" TextColor="{StaticResource BrushText}"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
