<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.ListComparisonPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding Loading}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <RefreshView IsRefreshing="{Binding Loading}" Refreshing="OnRefreshing"
                     IsVisible="{Binding Loading, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <CollectionView ItemsSource="{Binding CurrentItems}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No overlapping titles" FontFamily="Inter" FontSize="13"
                           TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8" Padding="10">
                            <Grid ColumnDefinitions="40,*,Auto,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" Source="{Binding ImgUrl, Converter={StaticResource ImageConverter}}"
                                       WidthRequest="36" HeightRequest="50" Aspect="AspectFill" />
                                <Label Grid.Column="1" Text="{Binding Title}" FontFamily="InterBold" FontSize="13"
                                       TextColor="{StaticResource BrushText}" VerticalOptions="Center"
                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                <Label Grid.Column="2" Text="{Binding WatchedDifferenceBind}"
                                       FontFamily="Inter" FontSize="11" TextColor="#80FFFFFF"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="3" Text="{Binding ScoreDifferenceBind}"
                                       FontFamily="Inter" FontSize="11" TextColor="{StaticResource EmAccent}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
