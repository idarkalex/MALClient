<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:MALPlus.Converters"
             x:Class="MALPlus.Views.ForumsTopicPage"
             BackgroundColor="{StaticResource EmBackground}">
    <ContentPage.Resources>
        <converters:StringToImageSourceConverter x:Key="ImageConverter" />
        <converters:BoolToVisibilityConverter x:Key="BoolVis" />
        <converters:HtmlSourceConverter x:Key="HtmlSource" />
    </ContentPage.Resources>

    <Grid>
        <Grid IsVisible="{Binding LoadingTopic}" BackgroundColor="#80000000" ZIndex="99">
            <ActivityIndicator IsRunning="True" Color="{StaticResource EmAccent}"
                               WidthRequest="36" HeightRequest="36" />
        </Grid>

        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding LoadingTopic, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <Label Grid.Row="0" Text="{Binding Header}" FontFamily="InterBold" FontSize="18"
                   TextColor="{StaticResource BrushText}" Padding="16,12" MaxLines="2"
                   LineBreakMode="TailTruncation" />

            <RefreshView Grid.Row="1" IsRefreshing="{Binding LoadingTopic}" Refreshing="OnRefreshing">
                <CollectionView ItemsSource="{Binding Messages}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No messages" FontFamily="Inter" FontSize="13"
                               TextColor="#80FFFFFF" HorizontalOptions="Center" VerticalOptions="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="16,4" BackgroundColor="{StaticResource EmSheet}"
                                    Stroke="{StaticResource EmBorder}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                                StrokeShape="RoundRectangle 18"
                                                Stroke="{StaticResource EmBorder}" StrokeThickness="1">
                                            <Image Source="{Binding Data.Poster.MalUser.ImgUrl, Converter={StaticResource ImageConverter}}"
                                                   Aspect="AspectFill" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Data.Poster.MalUser.Name}" FontFamily="InterBold" FontSize="14"
                                               TextColor="{StaticResource BrushText}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="{Binding Data.CreateDate}" FontFamily="Inter" FontSize="11"
                                               TextColor="#80FFFFFF" VerticalOptions="Center" />
                                    </Grid>
                                    <Label Grid.Row="1" Text="{Binding Data.MessageNumber, StringFormat='#{0}'}"
                                           FontFamily="InterBold" FontSize="10" TextColor="#A0FFFFFF" />
                                    <WebView Grid.Row="2" Source="{Binding Data.HtmlContent, Converter={StaticResource HtmlSource}}"
                                             HeightRequest="200" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>

            <!-- Reply composer -->
            <Border Grid.Row="2" BackgroundColor="{StaticResource EmSheet}"
                    Stroke="{StaticResource EmBorder}" StrokeThickness="1,1,0,0"
                    StrokeShape="RoundRectangle 0" Padding="12,8,12,12">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <Editor Grid.Row="0" Text="{Binding ReplyMessage, Mode=TwoWay}"
                            Placeholder="Write a reply (BBCode supported)..."
                            FontFamily="Inter" FontSize="13" HeightRequest="80"
                            BackgroundColor="{StaticResource EmBackground}"
                            TextColor="{StaticResource BrushText}"
                            PlaceholderColor="#80FFFFFF"
                            AutoSize="Disabled" />
                    <Button Grid.Row="1" Text="Post Reply" Command="{Binding CreateReplyCommand}"
                            HorizontalOptions="End"
                            FontFamily="InterSemiBold" FontSize="12"
                            BackgroundColor="#0066FF" TextColor="White"
                            CornerRadius="8" HeightRequest="32" Padding="12,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
